@using Application.Modules.Products

@model List<Domain.Entities.StoreModule.ProductVariant>

@{

}

<style>
    .paises-link {
        overflow: hidden;
    }

    .paises-list {
        padding-top: 10px;
        padding-bottom: 25px;
    }

    .paises-list .pais-container {
        max-width: calc(25% - 1px)
    }

    .pais-container .pais-link {
        overflow: hidden;
        font-size: 12px;
        display: block;
        text-transform: uppercase;
        font-weight: 400;
        color: #555;
        padding: 10px 0;
    }

    .pais-link .pais-imagem-container {
        margin: 0 auto;
        width: 70px;
        height: 70px;
        overflow: hidden;
    }

    .pais-link .pais-nome {
        color: #666;
        font-size: 14px;
        font-weight: 400;
        letter-spacing: -.5px;
        line-height: 1;
        margin-top: 1em;
        text-align: center;
        text-transform: none;
    }

    .pais-imagem-container .pais-imagem {
        position: relative;
        margin: 0;
        display: inline-block;
        vertical-align: middle;
    }

    @@media (max-width: 991px) {
        .paises-list .row {
            display: flex;
            flex-wrap: wrap;
            margin-left: -8px;
            margin-right: -8px;
        }

        .paises-list .Country {
            overflow: visible;
        }

        .pais-link .pais-imagem-container {
            margin: 0 auto;
            width: 50px;
            height: 50px;
        }
    }

    @@media (min-width: 768px) {
        .paises-list .pais-container {
            width: 14%;
        }
    }
</style>

<div class="container">
    <div class="row">
        <div class="col-xs-7 col-md-4">
            <a href="/categoria/vinhos/" class="paises-link" title="Todos os vinhos">
                <h2>Vinhos por país</h2>
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-xs-12 paises-list">
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-xs-3 col-sm-2 pais-container">
                        <a href="/categoria/vinhos/pais/@item.Slug" title="Vinhos @item.Name" class="pais-link">
                            <div class="pais-imagem-container">
                                <img class="pais-imagem" src="/assets/images/paises/@(item.Slug).png?w=100&h=100" alt="@item.Name">
                            </div>
                            <div class="pais-nome">
                                @item.Name
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>


