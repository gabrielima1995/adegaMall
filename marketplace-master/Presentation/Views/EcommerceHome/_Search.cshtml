
<div id="mainProductSearch" class="row main-product-search">
    <div class="col-xs-12 col-md-6 col-md-offset-3">
        @using (Html.BeginForm("Search", "Products", FormMethod.Get, new { id = "frmProductSearch", role = "form" }))
        {
            <input type="text" class="form-control input-lg" placeholder="@Request.GetLocalizedString("PRODUCT_FILTER_INPUT")" name="Product" />
            <div class="visible-xs btn-container">
                <button type="submit" class="btn btn-primary btn-block">
                    @Request.GetLocalizedString("PRODUCT_FIND_BUTTON")
                </button>
            </div>
        }
    </div>
</div>
