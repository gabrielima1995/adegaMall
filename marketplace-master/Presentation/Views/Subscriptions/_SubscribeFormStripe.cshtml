@model Application.Modules.Subscriptions.SubscribeViewModel

@using (Html.BeginForm("SubscribeStripe", "Membership", new { id = Model.SignMode.Id, lang = Request.GetCurrentLang() }, FormMethod.Post, new { id = "card-form", @class = "margin-top-10 margin-bottom-30", role = "form" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="row">
        <div class="col-xs-12">
            <div class="form-group">
                @Html.LabelFor(i => i.CreditCard.FullName)
                @Html.TextBoxFor(i => i.CreditCard.FullName, new { id = "cardholder-name", @class = "form-control", placeholder = Request.GetLocalizedString("CREDIT_CARD_FULLNAME_INPUT") })
                @Html.ValidationMessageFor(model => model.CreditCard.FullName, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xs-12">
            <div class="form-group">
                <label for="card-element">
                    @Request.GetLocalizedString("CREDIT_CARD_LABEL")
                </label>
                <div id="card-element">
                    <!-- A Stripe Element will be inserted here. -->
                </div>

                <!-- Used to display form errors. -->
                <div id="card-errors" role="alert" class="text-danger"></div>
            </div>
        </div>
    </div>

    <div class="form-group">
        @Html.Localized("CONFIRM_SIGN_BUTTON", "button", new { id = "card-button", type = "submit", @class = "btn btn-primary btn-block box-shadow" })
    </div>
}
