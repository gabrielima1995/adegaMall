@model Application.Modules.Subscriptions.SubscribeViewModel

@{
    ViewBag.Title = Request.GetLocalizedString("SIGN_TITLE");
    var isStripe = MaaSConfig.Current.Payment.GatewayIsStripe();
}

<div class="main-content bg-image-2 padding-top-120 padding-bottom-120">
    <div class="container">
        <div class="row">
            <div class="col-xs-12 col-sm-offset-3 col-sm-6">
                <div class="outer-title">
                    @Html.Localized("SIGN_TITLE", "h2", new { @class = "color_white" })
                </div>
                <div class="box-content">
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="m-b-md">
                                <div class="membership-option">
                                    <div class="row">
                                        <div class="col-xs-12 text-center">
                                            <span class="title">@Model.SignMode.Title</span>
                                        </div>
                                        <div class="col-xs-12 text-center">
                                            <p class="price">
                                                @Model.SignMode.CurrencySymbol @Model.SignMode.Price.DisplayDecimal(2)
                                            </p>
                                            @if (MaaSConfig.Current.Quote.LeadSales.Enabled && Model.SignMode.CreditsPerMonth.HasValue)
                                            {
                                                <p>
                                                    <i class="fas fa-coins"></i> @Html.Localized("CREDITS_PER_MONTH", "span", null, Model.SignMode.CreditsPerMonth.Value)
                                                </p>
                                            }
                                            <span class="description">@string.Format(Model.SignMode.Description, Model.SignMode.Price.DisplayDecimal(2), Model.SignMode.CurrencySymbol)</span>
                                            @if (Model.SignMode.IsTrial)
                                            {
                                                <br /><small class="text-success">@Request.GetLocalizedString("SUBSCRIPTION_HAS_TRIAL", Model.SignMode.TrialDays)</small>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    @Html.Partial(isStripe ? "~/Views/Subscriptions/_SubscribeFormStripe.cshtml" : "~/Views/Subscriptions/_SubscribeForm.cshtml", Model)
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    @if (isStripe)
    {
        @Html.Partial("~/Views/Subscriptions/_SubscribeStripeScript.cshtml")
    }
}