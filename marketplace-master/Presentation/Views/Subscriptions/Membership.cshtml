@model IEnumerable<Application.Modules.Subscriptions.SignModeViewModel>

@{
    ViewBag.Title = Request.GetLocalizedString("SIGN_TITLE");

    var planIndex = 0;
}

<div class="main-content bg-image-2 padding-top-120 padding-bottom-120">
    <div class="container">
        <div class="row">
            @Html.Partial("~/Views/Subscriptions/_SignHelpQuestions.cshtml")

            <div class="visible-xs margin-top-30 col-xs-12"></div>

            <div class="col-xs-12 col-sm-6 col-md-5">
                <div class="box-content text-center equal-height">
                    <div class="row">
                        <div class="col-xs-12">
                            @foreach (var item in Model)
                            {
                                <div class="membership-option @(planIndex++ == 0 ? "popular" : "")">
                                    <div class="row">
                                        <div class="col-xs-12 col-md-6 xs-text-center sm-text-center">
                                            <p class="title">@item.Title</p>
                                            <span class="description">@string.Format(item.Description, item.Price.DisplayDecimal(2), item.CurrencySymbol)</span>
                                            @if (item.IsTrial)
                                            {
                                                <br /><small class="text-success">@Request.GetLocalizedString("SUBSCRIPTION_HAS_TRIAL", item.TrialDays)</small>
                                            }
                                        </div>

                                        <div class="col-xs-12 col-md-6 xs-text-center sm-text-center">
                                            <p class="price">
                                                @item.CurrencySymbol @item.PriceMonthly.DisplayDecimal(2) @Html.Localized("MONTHLY_TEXT")
                                            </p>
                                            @if (MaaSConfig.Current.Quote.LeadSales.Enabled && item.CreditsPerMonth.HasValue)
                                            {
                                                <div class="text-center">
                                                    <p>
                                                        <i class="fas fa-coins"></i> @Html.Localized("CREDITS_PER_MONTH", "span", null, item.CreditsPerMonth.Value)
                                                    </p>
                                                </div>
                                            }
                                            @Html.Localized("SIGN_BUTTON", "a", new { href = Url.ActionLocalized("Subscribe", "Membership", new { id = item.Id }), @class = "btn btn-primary btn-block" })
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>