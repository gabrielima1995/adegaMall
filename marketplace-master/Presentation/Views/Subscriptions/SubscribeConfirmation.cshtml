@{
    ViewBag.Title = Request.GetLocalizedString("SIGN_TITLE");
}

<div class="main-content bg-image-2 padding-top-120 padding-bottom-120">
    <div class="container">
        <div class="row">
            <div class="col-xs-12 col-sm-offset-3 col-sm-6 col-md-offset-4 col-md-4">
                <div class="outer-title">
                    @Html.Localized("SIGN_TITLE", "h2", new { @class = "color_white" })
                </div>

                <div class="box-content">
                    <div class="form-group">
                        <div class="bg-secondary color-white block text-center padding-5 border-radius">@Html.Localized("CONFIRM_SIGN_SUCCESS_MESSAGE")</div>
                    </div>
                    <small class="text-center block">
                        @Html.Localized("MY_ACCOUNT_LINK", "a", new { href = Url.ActionLocalized("Index", "Manage"), @class = "underline" })
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>
