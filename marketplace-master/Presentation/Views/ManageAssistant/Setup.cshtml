@model ViewModelBase<Presentation.Controllers.ManageAssistantSetupViewModel>

@{
    ViewBag.Title = Request.GetLocalizedString("SELLER_ASSISTANT_TITLE");
    var loginProfile = User.Identity.GetLoginProfile();
}

<div class="main-content bg-1 padding-top-30 padding-bottom-60">
    <div class="container">
        <div class="row">
            <div class="col-xs-12">
                @Html.Partial("_UserMenu", loginProfile)

                <h3>
                    <i class="fas fa-user-cog"></i>
                    @Html.Localized("SELLER_ASSISTANT_TITLE")
                </h3>

                <div class="alert alert-info">@Html.Localized("SELLER_ASSISTANT_TEXT")</div>

                <div class="panel panel-default">
                    <div class="panel-body">
                        @using (Html.BeginForm())
                        {
                            <div class="form-group">
                                @Html.Localized("SELLER_ASSISTANT_SETUP_EMAIL_LABEL", "strong")
                                @Html.TextBoxFor(model => model.Data.Email, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.Data.Email, null, new { @class = "text-danger" })
                                <div class="help-block">@Html.Localized("SELLER_ASSISTANT_SETUP_EMAIL_HELP", "small")</div>
                            </div>
                            <button type="submit" class="btn btn-default">
                                @Html.LocalizedString("SELLER_ASSISTANT_SETUP_SAVE")
                                <i class="fas fa-chevron-circle-right"></i>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
