@using Domain.StoreModule.Entities
@model Presentation.Models.ScheduleViewModels.NewAvailabilityVM

@using (Html.BeginForm("NewAvailability", "Schedule", new { lang = Request.GetCurrentLang(), area = "" }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="row">
        <div class="col-xs-12 col-md-6">
            <div class="panel panel-default">
                <div class="panel-body js-days-of-week-container">
                    @Html.Partial("_NewAvailabilityDaysOfWeekForm", Model)
                </div>
            </div>
        </div>

        <div class="col-xs-12 col-md-6">
            <div class="form-group">
                <div class="btn-group" data-toggle="buttons">
                    <label class="btn btn-default @(!Model.IsSpecificProduct ? "active" : "")">
                        <i class="fa fa-cubes"></i>
                        <input type="radio" name="IsSpecificProduct" autocomplete="off" value="false" @(!Model.IsSpecificProduct ? "checked" : "")> @Html.Localized("NEW_LOCK_TARGET_ALL_STORE")
                    </label>
                    <label class="btn btn-default @(Model.IsSpecificProduct ? "active" : "")">
                        <i class="fa fa-cube"></i>
                        <input type="radio" name="IsSpecificProduct" autocomplete="off" value="true" @(Model.IsSpecificProduct ? "checked" : "")> @Html.Localized("NEW_LOCK_TARGET_SPECIFIC_PRODUCT")
                    </label>
                </div>
            </div>

            <div class="js-all-store-container">
                @Html.Localized("NEW_AVAILABILITY_ALL_STORE_DESCRIPTION", "small", new { @class = "text-muted" })
            </div>

            <div class="js-product-container" style="display: none">
                @Html.DropDownListFor(model => model.ProductId,
                         ViewBag.Products as SelectList,
                         Request.GetLocalizedString("NEW_LOCK_PRODUCT_SELECT"),
                         new { @class = "form-control js-product" })
                @Html.ValidationMessageFor(model => model.ProductId, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xs-12">
            <div class="alert alert-warning" role="alert">
                @Html.Localized("NEW_AVAILABILITY_WARNING")
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xs-12">
            <div class="form-group">
                <button type="submit" class="btn btn-primary btn-block btn-lg" id="js-submit">
                    <i class="fa fa-check" aria-hidden="true"></i>
                    @Html.Localized("SAVE_NEW_AVAILABILITY_BUTTON")
                </button>
            </div>
        </div>
    </div>
}