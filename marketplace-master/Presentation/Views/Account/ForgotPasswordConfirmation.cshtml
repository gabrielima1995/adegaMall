@{
    ViewBag.Title = Request.GetLocalizedString("FORGOT_PASSWORD_TITLE");
}

<!-- CONTENTS -->
<div class="main-content bg-image-2 padding-top-120 padding-bottom-120">
    <div class="container">
        <div class="row">
            <div class="col-xs-12 col-sm-offset-3 col-sm-6 col-md-offset-4 col-md-4">
                <div class="outer-title">
                    @Html.Localized("FORGOT_PASSWORD_TITLE", "h2", new { @class = "color_white" })
                </div>

                <div class="box-content">
                    <div class="form-group">
                        <div class="bg-secondary color-white block text-center padding-5 border-radius">@Html.Localized("FORGOT_PASSWORD_SUCCESS_TEXT")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- /CONTENTS -->