@model Domain.DTO.ResetPasswordViewModel

@{
    ViewBag.Title = Request.GetLocalizedString("RESET_PASSWORD_TITLE");
}

<div class="main-content bg-image-2 padding-top-120 padding-bottom-120 reset-password-page">
    <div class="container">
        <div class="row">
            <div class="col-xs-12 col-sm-offset-3 col-sm-6 col-md-offset-4 col-md-4">
                <div class="outer-title">
                    @Html.Localized("RESET_PASSWORD_TITLE", "h2", new { @class = "color_white" })
                </div>

                <div class="box-content">
                    @using (Html.BeginForm("ResetPassword", "Account", new { lang = Request.GetCurrentLang() }, FormMethod.Post, new { @class = "margin-top-10 margin-bottom-30", role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        @Html.HiddenFor(model => model.Code)

                        <div class="form-group">
                            @Html.LabelFor(i => i.Email)
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = Request.GetLocalizedString("EMAIL_INPUT") })
                            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(i => i.Password)
                            @Html.PasswordFor(i => i.Password, new { @class = "form-control", placeholder = Request.GetLocalizedString("NEW_PASSWORD_INPUT") })
                            @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(i => i.ConfirmPassword)
                            @Html.PasswordFor(i => i.ConfirmPassword, new { @class = "form-control", placeholder = Request.GetLocalizedString("CONFIRM_NEW_PASSWORD_INPUT") })
                            @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.Localized("RESET_PASSWORD_BUTTON", "button", new { type = "submit", @class="btn btn-primary btn-block box-shadow" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
