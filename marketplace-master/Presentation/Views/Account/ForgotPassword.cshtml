@model Domain.DTO.ForgotPasswordViewModel

@{
    ViewBag.Title = Request.GetLocalizedString("FORGOT_PASSWORD_TITLE");
}

<!-- CONTENTS -->
<div class="main-content bg-image-2 padding-top-120 padding-bottom-120">
    <div class="container">
        <div class="row">
            <div class="col-xs-12 col-sm-offset-3 col-sm-6 col-md-offset-4 col-md-4">
                <div class="outer-title">
                    @Html.Localized("FORGOT_PASSWORD_TITLE", "h2", new { @class = "color_white" })
                </div>

                <div class="box-content">
                    @Html.Localized("FORGOT_PASSWORD_TEXT", "p", new { @class = "text-center" })

                    @using (Html.BeginForm("ForgotPassword", "Account", new { lang = Request.GetCurrentLang() }, FormMethod.Post, new { @class = "margin-top-10 margin-bottom-30", role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="form-group">
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = Request.GetLocalizedString("EMAIL_INPUT") })
                            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.Localized("FORGOT_PASSWORD_SEND_BUTTON", "button", new { type = "submit", @class = "btn btn-primary btn-block box-shadow" })
                        </div>
                    }

                    @Html.Localized("FORGOT_PASSWORD_BOTTOM_TEXT", "small", new { @class = "text-center block" })
                </div>
            </div>
        </div>
    </div>
</div>
<!-- /CONTENTS -->