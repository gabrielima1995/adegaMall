@model Domain.DTO.LoginViewModel

@{
    ViewBag.Title = Request.GetLocalizedString("LOGIN_TITLE");

    var config = MaaSConfig.Current;
    var showLoginToSearchMsg = config.Search.RequireLogin && Request.QueryString["logintosearch"] != null;
}

<!-- CONTENTS -->
<div class="main-content bg-image-2 padding-top-120 padding-bottom-120">
    <div class="container">
        <div class="row">
            <div class="col-xs-12 col-sm-offset-1 col-sm-10 col-md-offset-4 col-md-4">
                <div class="login-title outer-title">
                    @Html.Localized("LOGIN_TITLE", "h2")
                </div>

                <div class="login-box box-content">
                    @if (showLoginToSearchMsg)
                    {
                        <div class="login-box-search-alert alert alert-info">
                            @Html.Localized("LOGIN_TO_SEARCH", "span")
                        </div>
                    }

                    @if (!config.Facebook.DisableLoginForBuyer || !config.Facebook.DisableLoginForSeller)
                    {
                        using (Html.BeginForm("ExternalLogin", "Account", new { lang = Request.GetCurrentLang(), returnUrl = ViewBag.ReturnUrl, @class = "login-box-external" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Localized("JOIN_FACEBOOK_BUTTON", "button", new { type = "submit", @class = "facebook-btn", id = "Facebook", name = "provider", value = "Facebook" })
                        }

                        <p class="login-box-or text-center">
                            @Html.Localized("OR_TEXT")<br />
                            @Html.Localized("LOGIN_FORM_TEXT")
                        </p>
                    }

                    @using (Html.BeginForm("Login", "Account", new { lang = Request.GetCurrentLang(), returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "login-box-form margin-top-10 margin-bottom-5", role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "login-box-errors text-danger" })
                        <div class="form-group">
                            @Html.TextBoxFor(i => i.Email, new { @class = "form-control", placeholder = Request.GetLocalizedString("EMAIL_INPUT"), type = "email" })
                            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.PasswordFor(i => i.Password, new { @class = "form-control", placeholder = Request.GetLocalizedString("PASSWORD_INPUT") })
                            @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group text-center">
                            @Html.Localized("LOGIN_BUTTON", "button", new { type = "submit", @class = "login-box-button btn btn-primary btn-block margin-bottom-5" })

                            <small class="block margin-bottom-30">
                                @Html.Localized("FORGOT_PASSWORD_LINK", "a", new { href = Url.ActionLocalized("ForgotPassword", "Account"), @class = "login-box-forgot" })
                            </small>
                        </div>

                        <hr class="login-box-separator" />

                        <div class="login-box-register text-center">
                            <p class="login-box-register-title">@Html.Localized("NEW_HERE_TEXT", "small")</p>

                            @Html.Localized("SELLER_JOIN_BUTTON_FULL", "a", new { href = Url.ActionLocalized("Seller", "Register", new { returnUrl = ViewBag.ReturnUrl }), @class = "login-box-register-seller" })

                            @if (config.Buyer.Enabled)
                            {
                                <span class="login-box-register-separator">|</span>
                                @Html.Localized("BUYER_JOIN_BUTTON_FULL", "a", new { href = Url.ActionLocalized("Buyer", "Register", new { returnUrl = ViewBag.ReturnUrl }), @class = "login-box-register-buyer" })
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<!-- /CONTENTS -->