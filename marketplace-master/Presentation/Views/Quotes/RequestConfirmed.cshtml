@{
    ViewBag.Title = Request.GetLocalizedString("HIRE_CONFIRMED_TITLE");

    var msgLabel = ViewBag.SellerName == null
        ? "HIRE_CONFIRMED_GENERAL_TEXT"
        : "HIRE_CONFIRMED_SPECIFIC_TEXT";

    var msg = string.Format(Request.GetLocalizedString(msgLabel), ViewBag.SellerName ?? "");
}

<div class="main-content bg-image-2 padding-top-120 padding-bottom-120">
    <div class="container">
        <div class="row">
            <div class="col-xs-12 col-sm-offset-3 col-sm-6 col-md-offset-4 col-md-4">
                <div class="outer-title">
                    @Html.Localized("HIRE_CONFIRMED_TITLE", "h2", new { @class = "color_white" })
                </div>

                <div class="box-content">
                    <div class="form-group">
                        @Html.Localized("ALL_RIGHT_TEXT", "div", new { @class = "bg-secondary color-white block text-center padding-5 border-radius" })
                    </div>

                    <p class="text-center" data-label="@msgLabel">@msg</p>

                    <small class="text-center block">
                        @Html.Localized("BACK_TO_HOME_LINK", "a", new { href = Url.ActionLocalized("Index", "Home"), @class = "underline" })
                    </small>
                    <small class="text-center block">
                        @Html.Localized("SEE_MY_QUOTES_BUYER", "a", new { href = Url.ActionLocalized("Buyer", "Quotes"), @class = "underline" })
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>
