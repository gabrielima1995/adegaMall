@model Presentation.Models.QuoteListVM
@{
    bool onlyUnlocked = Request.QueryString.Get("filter") == "onlyUnlocked";
    bool onlyLocked = Request.QueryString.Get("filter") == "onlyLocked";
}

<div class="row">
    <div class="col-xs-12">
        <div class="form-group">
            <div class="btn-group quote-status-nav" role="group">
                <a href="@Url.ActionLocalized("Index", "Quotes")" class="btn btn-default quote-status-nav-item @(Model.ViewingOpenQuotes ? "active" : "")">
                    @Html.Localized("OPEN_REQUESTS_BUTTON")
                    @BadgeCount(Model.TotalOpenQuotes)
                </a>
                <a href="@Url.ActionLocalized("Index", "Quotes", new { view = "ongoing" })" class="btn btn-default quote-status-nav-item @(Model.ViewingOngoingQuotes ? "active" : "")">
                    @Html.Localized("ONGOING_REQUESTS_BUTTON")
                    @BadgeCount(Model.TotalOngoingQuotes)
                </a>
                <a href="@Url.ActionLocalized("Index", "Quotes", new { view = "closed" })" class="btn btn-default quote-status-nav-item @(Model.ViewingClosedQuotes ? "active" : "")">
                    @Html.Localized("ARCHIVED_REQUESTS_BUTTON")
                    @BadgeCount(Model.TotalClosedQuotes)
                </a>
            </div>
        </div>
    </div>
</div>

@helper BadgeCount(int count)
{
    if (count > 0)
    {
        <span class="badge bg-danger js-open-requests-badge">@count</span>
    }
}