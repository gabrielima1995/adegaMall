@model Presentation.Models.QuoteVM

@{
    ViewBag.Title = Request.GetLocalizedString("QUOTE_SELLER_TITLE");
    ViewBag.SubCategoriesBySeller = Model.SellerId;

    var viewPathFormat = "~/Views/Quotes/{0}.cshtml";
    var cssClass = Model.SellerId != null
        ? "col-xs-12 col-md-offset-2 col-md-8"
        : "col-xs-12 col-sm-offset-1 col-sm-11 col-md-offset-3 col-md-9";
}

<div class="main-content bg-1 padding-top-30 padding-bottom-60">
    <div class="container">
        <div class="row">
            <div class="@cssClass">
                <div class="container-fluid">
                    @if (Model.SellerId != null)
                    {
                        <div class="row margin-bottom-15">
                            <div class="col-xs-12">
                                <h1 class="seller-title m-b-0">@Model.SellerName</h1>
                            </div>
                        </div>
                    }

                    <div class="row">
                        @if (Model.SellerId != null)
                        {
                            <div class="col-xs-12 col-sm-4">
                                <div class="foto-perfil">
                                    <img src="@Model.SellerAvatar" alt="@Model.SellerName" class="border-radius">
                                </div>
                            </div>
                        }

                        <div class="col-xs-12 col-sm-8">
                            <div class="row">
                                <div class="col-xs-12">
                                    @Html.Localized("QUOTE_SELLER_TITLE", "h4")
                                    @Html.Localized("QUOTE_SELLER_STEP_1_TEXT", "p")
                                </div>
                            </div>
                            @Html.Partial(string.Format(viewPathFormat, "_RequestForm"), Model)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    @Html.Partial("_SubCategoriesScript", new ViewDataDictionary { { "seller", Model.SellerId } })
    @Html.Partial("_GoogleMapsScript")
    <script>CitiesScript.init('@Request.GetLocalizedString("CITY_AND_STATE_INPUT")')</script>
    @if (MaaSConfig.Current.Quote.GeneralQuoteCity.Enabled)
    {
        if (MaaSConfig.Current.Quote.UseBrowserGeolocation)
        {
            <script>GoogleMapsAutocomplete.init()</script>
        }
        else
        {
            <script>GoogleMapsAutocomplete.initNoLocation()</script>
        }
    }
    <script>
        QuoteRequest.init({
            "autoFillAddress": {
                "url": "@Url.ActionLocalized("GetAddress", "Quotes")",
                "incompleteMessage": "@Request.GetLocalizedString("MUST_REGISTER_ADDRESS_IN_MYACCOUNT")"
            }
        });
    </script>
}