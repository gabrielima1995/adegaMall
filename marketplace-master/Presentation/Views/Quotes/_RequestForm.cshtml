@model Presentation.Models.QuoteVM

@{
    var config = MaaSConfig.Current;
    var isBuyer = User.Identity.GetLoginProfile().IsBuyer() || Model.BuyerId != null;
}

<div class="row">
    @using (Html.BeginForm("Request", "Quotes", new { lang = Request.GetCurrentLang(), area = "" }, FormMethod.Post, new { enctype = "multipart/form-data", id = "quote-request-form" }))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(model => model.BuyerId)
        @Html.HiddenFor(model => model.SellerId)
        @Html.HiddenFor(model => model.SellerName)
        @Html.HiddenFor(model => model.SearchQueryString)
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        @Html.HiddenFor(model => model.PhoneForRegisterRequired)
        @Html.HiddenFor(model => model.PhoneRequired)
        @Html.HiddenFor(model => model.DateRequired)
        @Html.HiddenFor(model => model.CityAndStateRequired)
        @Html.HiddenFor(model => model.GeneralQuoteCityRequired)
        @Html.HiddenFor(model => model.QuoteMaxRequired)
        @Html.HiddenFor(model => model.AddressRequired)
        @Html.HiddenFor(model => model.CategoriesRequired)
        @Html.HiddenFor(model => model.QuantityRequired)

        <div id="js-step1" style="@(isBuyer ? "display:none" : "")" data-start="@(isBuyer ? "0" : "1")">
            <div class="col-xs-12">
                <div class="form-group">
                    @Html.TextBoxFor(i => i.BuyerName, new { @class = "form-control js-step1-control register-required", placeholder = Request.GetLocalizedString("NAME_INPUT") })
                    @Html.ValidationMessageFor(model => model.BuyerName, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.TextBoxFor(i => i.BuyerEmail, new { @class = "form-control js-step1-control register-required", placeholder = Request.GetLocalizedString("EMAIL_INPUT"), type = "email", autocomplete = "new-password" })
                    @Html.ValidationMessageFor(model => model.BuyerEmail, "", new { @class = "text-danger" })
                </div>

                @if (Model.ShowPhoneForRegister)
                {
                    <div class="form-group">
                        @Html.TextBoxFor(i => i.BuyerPhone, new { @class = "form-control js-step1-control" + (Model.PhoneForRegisterRequired ? " register-required" : ""), placeholder = Request.GetLocalizedString("PHONE_INPUT") })
                        @Html.ValidationMessageFor(model => model.BuyerPhone, "", new { @class = "text-danger" })
                    </div>
                }

                <div class="form-group">
                    @Html.TextBoxFor(i => i.NewPassword, new { id = "js-step1-pwd", @class = "form-control js-step1-control register-required", type = "password", placeholder = Request.GetLocalizedString("QUOTE_REGISTER_PASSWORD"), autocomplete = "new-password" })
                    @Html.ValidationMessageFor(model => model.NewPassword, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.TextBoxFor(i => i.ConfirmPassword, new { id = "js-step1-pwd-cfm", @class = "form-control js-step1-control register-required", type = "password", placeholder = Request.GetLocalizedString("QUOTE_REGISTER_PASSWORD_REPEAT"), autocomplete = "new-password" })
                    @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.Localized("QUOTE_CONTINUE_BUDGED_BUTTON", "button", new { id = "js-button-continue", type = "button", @class = "btn btn-primary btn-block box-shadow" })
                </div>
            </div>
        </div>

        <div id="js-step2" style="@(!isBuyer ? "display:none" : "")">
            <div class="col-xs-12">
                <div class="form-group">
                    @Html.TextBoxFor(i => i.Title, new { @class = "form-control input-lg", placeholder = Request.GetLocalizedString("QUOTE_TITLE_INPUT") })
                    @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(i => i.Description)
                    @Html.TextAreaFor(i => i.Description, new { @class = "form-control", placeholder = Request.GetLocalizedString("QUOTE_DESCRIPTION_INPUT"), rows = 5 })
                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                </div>

                <div class="row">
                    @if (Model.ShowQuantity)
                    {
                        <div class="form-group col-md-4">
                            @Html.LabelFor(i => i.Quantity)
                            @Html.EditorFor(i => i.Quantity, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Quantity, "", new { @class = "text-danger" })
                        </div>
                    }

                    @if (Model.IsPortfolioItemQuoteRequest)
                    {
                        @Html.HiddenFor(i => i.PortfolioItemId)

                        <div class="form-group col-md-8">
                            @Html.LabelFor(i => i.PortfolioItemTitle)
                            <br />
                            <span style="display: block; margin-top: 6px">@Html.DisplayFor(model => model.PortfolioItemTitle)</span>
                        </div>
                    }
                </div>

                @if (Model.ShowPreference)
                {
                    <div class="form-group">
                        @Html.LabelFor(i => i.Preference)

                        <div class="btn-group" data-toggle="buttons">
                            <label class="btn btn-default active">
                                <input type="radio" name="Preference" autocomplete="off" value="Quality" checked="checked"> @Html.Localized("PREF_QUALITY_LABEL")
                            </label>
                            <label class="btn btn-default">
                                <input type="radio" name="Preference" autocomplete="off" value="Price"> @Html.Localized("PREF_PRICE_LABEL")
                            </label>
                        </div>
                    </div>
                }

                @if (Model.ShowQuoteMax)
                {
                    <div class="form-group">
                        @Html.LabelFor(i => i.Amount)
                        <div class="input-group">
                            <span class="input-group-addon">@config.DefaultCurrency</span>
                            @Html.TextBoxFor(i => i.Amount, new { @class = "form-control js-money" })
                        </div>
                    </div>

                    @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "text-danger" })
                }

                @if (Model.ShowCustomFields)
                {
                    <hr />
                    for (int i = 0; i < Model.CustomFieldDefinitions.Count; i++)
                    {
                        <div class="form-group">
                            @{
                                ViewData["Index"] = i;
                                Write(Html.Partial("_CustomFieldForms", Model, ViewData));
                            }
                        </div>
                    }
                }

                @if (Model.ShowAttachment)
                {
                    <div class="form-group">
                        @Html.Localized("QUOTE_ATTACHMENT_LABEL", "label")
                        <input type="file" name="quoteAttachment" class="form-control" />
                        @Html.Localized("QUOTE_ATTACHMENT_INFO", "small", new { @class = "text-muted" })
                    </div>
                }
            </div>

            <div>
                @if (Model.ShowCategories || Model.ShowGeneralQuoteCity)
                {
                    <div class="col-xs-12">
                        <hr style="margin-top: 0" />
                        @Html.Localized("QUOTE_FILTER_SELLERS_TITLE", "h4")
                        @Html.Localized("QUOTE_FILTER_INFO", "small", new { @class = "text-muted" })
                    </div>
                }

                @if (Model.ShowCategories)
                {
                    <div class="col-xs-12 col-md-6">
                        <div class="form-group m-b-xs">
                            @Html.DropDownList("CategoryId", null, Request.GetLocalizedString("CATEGORY_SELECT"), new { @class = "form-control js-category js-select" })
                            @Html.ValidationMessageFor(model => model.CategoryId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-xs-12 col-md-6">
                        <div class="form-group m-b-xs">
                            @Html.DropDownList("SubCategoryId", null, Request.GetLocalizedString("SUB_CATEGORIES_SELECT"), new { @class = "form-control js-subCategory js-select" })
                            @Html.ValidationMessageFor(model => model.SubCategoryId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                }

                @if (Model.ShowGeneralQuoteCity)
                {
                    <div class="col-xs-12 m-t-sm">
                        @Html.Localized("QUOTE_REQUEST_LOCATION_FILTER_LABEL", "label")
                        <div class="form-group">
                            <input id="GoogleMapsAutocomplete" name="" class="form-control" />
                            @Html.HiddenFor(model => model.GeneralQuoteCityRequired)
                            @Html.ValidationMessageFor(model => model.Address, Request.GetLocalizedString("QUOTE_REQUEST_LOCATION_FILTER_IS_MANDATORY"), new { @class = "text-danger" })
                            @Html.Localized("QUOTE_REQUEST_LOCATION_FILTER_TEXT", "small", new { @class = "text-muted help-block" })

                            @Html.HiddenFor(model => model.Location, new { id = "hdnLocationName" })
                            @Html.HiddenFor(model => model.Address, new { id = "hdnLocationAddress" })

                            @Html.HiddenFor(model => model.Lat, new { id = "hdnLocationLat" })
                            @Html.HiddenFor(model => model.Lng, new { id = "hdnLocationLng" })

                            @Html.HiddenFor(model => model.BoundsAX, new { id = "hdnBoundsAX" })
                            @Html.HiddenFor(model => model.BoundsAY, new { id = "hdnBoundsAY" })
                            @Html.HiddenFor(model => model.BoundsBX, new { id = "hdnBoundsBX" })
                            @Html.HiddenFor(model => model.BoundsBY, new { id = "hdnBoundsBY" })
                        </div>
                    </div>
                }

                <div class="col-xs-12">
                    @Html.ValidationMessage("NoEligibleSellers", new { @class = "not-sellers-message" })
                </div>
            </div>

            @if (Model.ShowAddress || Model.ShowCityAndState || Model.ShowPhone || Model.ShowDate)
            {
                <div class="col-xs-12">
                    <hr style="margin-top: 0" />
                    @Html.Localized("QUOTE_DATA_LABEL", "h4")
                </div>
            }

            @if (Model.ShowAddress)
            {
                <div class="col-xs-12">
                    @Html.Localized("ADDRESS_INPUT", "label")
                    @if (User.Identity.GetLoginProfile().IsBuyer())
                    {
                        <a id="get-address-button" class="text-primary pull-right" href="#"><i class="fa fa-arrow-down"></i> @Request.GetLocalizedString("USE_REGISTERED_ADDRESS")</a>
                        <p id="address-f-error" class="pull-right" style="display:none"><small class="text-danger"> </small></p>
                    }
                </div>

                <div class="col-xs-12 col-sm-9">
                    <div class="form-group">
                        @Html.TextBoxFor(i => i.AddressStreet, new { id = "address-f1", @class = "form-control", placeholder = Request.GetLocalizedString("ADDRESS_INPUT") })
                        @Html.ValidationMessageFor(model => model.AddressStreet, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-xs-12 col-sm-3">
                    <div class="form-group">
                        @Html.TextBoxFor(i => i.AddressNumber, new { id = "address-f2", @class = "form-control", placeholder = Request.GetLocalizedString("ADDRESS_NUMBER_INPUT") })
                        @Html.ValidationMessageFor(model => model.AddressNumber, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-xs-12 col-sm-8">
                    <div class="form-group">
                        @Html.TextBoxFor(i => i.AddressNeighborhood, new { id = "address-f3", @class = "form-control", placeholder = Request.GetLocalizedString("NEIGHBORHOOD_INPUT") })
                        @Html.ValidationMessageFor(model => model.AddressNeighborhood, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-xs-12 col-sm-4">
                    <div class="form-group">
                        @Html.TextBoxFor(i => i.AddressZipCode, new { id = "address-f4", @class = "form-control js-zipcode", placeholder = Request.GetLocalizedString("ZIPCODE_INPUT") })
                        @Html.ValidationMessageFor(model => model.AddressZipCode, "", new { @class = "text-danger" })
                    </div>
                </div>
            }

            @if (Model.ShowCityAndState)
            {
                <div class="col-xs-12">
                    <div class="form-group">
                        @Html.LabelFor(i => i.CityAndState)
                        @Html.Partial("_CitiesSelect", Model)
                    </div>
                </div>
            }

            @if (Model.ShowPhone)
            {
                <div class="col-xs-12 col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(i => i.Phone)
                        @Html.TextBoxFor(i => i.Phone, new { @class = "form-control", placeholder = Request.GetLocalizedString("PHONE_INPUT") })
                        @Html.ValidationMessageFor(model => model.Phone, "", new { @class = "text-danger" })
                    </div>
                </div>
            }

            @if (Model.ShowDate)
            {
                <div class="col-xs-12 col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(i => i.Date)
                        @Html.TextBoxFor(i => i.Date, new { @class = "form-control js-date", placeholder = "__/__/____" })
                        @Html.ValidationMessageFor(model => model.Date, "", new { @class = "text-danger" })
                    </div>
                </div>
            }

            @if (Model.IsSearchQuoteRequest)
            {
                <div class="col-xs-12">
                    <hr />
                    @Html.Label(Request.GetLocalizedString("SELLERS_LANG_UBIQUITOUS"))
                    <p>
                        @foreach (var item in Model.SearchSellerAvatars)
                        {
                            <img src="@(Application.Helpers.ImgHelper.Avatar(item, 48))" class="img-circle" />
                        }
                        @if (Model.SearchSellerCount > 3)
                        {
                            <span class="additional-sellers-count badge">+@(Model.SearchSellerCount - 3)</span>
                        }
                    </p>
                    @Html.Localized("QUOTE_SELLERS_FOUND", "small", null, Model.SearchSellerCount)
                    <hr />
                </div>
            }

            @if (MaaSConfig.Current.Layout.TransactionWarrantyDisplay.ShowReassuringMessages)
            {
                <div class="col-xs-12">
                    @Html.Partial("_TransactionWarrantyReassuranceMsg")
                </div>
            }

            <div class="col-xs-12">
                @Html.Localized("QUOTE_SEND_BUTTON", "button", new { type = "submit", @class = "btn btn-primary btn-block margin-bottom-15" })

                @if (config.Enterprise.TermsOfUseUrl != null)
                {
                    <p class="text-center">
                        <small>
                            @Html.Localized("AGREE_TERMS_USE_TEXT")
                            <br>
                            @Html.Localized("TERMS_USE_LINK", "a", new { href = config.Enterprise.TermsOfUseUrl, target = "_blank", @class = "underline" })
                        </small>
                    </p>
                }
            </div>
        </div>
    }
</div>