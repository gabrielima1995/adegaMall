<div class="map-popup">
    <center>
        <a href="{DETAILS_URL}"><img src="{IMAGE_URL}" width="180" height="180" class="img-responsive map-popup-avatar" /></a>
        <h3>{TITLE}</h3>
        <p>{DISTANCE}</p>
        <p class="map-popup-icons">
            <a href="{DETAILS_URL}" title="detalhes"><span class="fa fa-id-card"></span></a>
            &nbsp;&nbsp;
            <a href="{MAPS_URL}" title="@Request.GetLocalizedString("PROFILE_CONTACT_VIEW_ON_MAP")" target="_blank"><span class="fa fa-map-marker"></span></a>
            &nbsp;&nbsp;
            <a href="{DIRECTIONS_URL}" title="@Request.GetLocalizedString("PROFILE_CONTACT_DIRECTIONS")" target="_blank"><span class="fa fa-car"></span></a>
        </p>
    </center>
</div>
