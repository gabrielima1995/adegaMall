@using Microsoft.AspNet.Identity

@model Presentation.Models.BuyerProfileVM

@{
    ViewBag.Title = Request.GetLocalizedString("MY_ACCOUNT_LINK");

    ViewBag.CompleteRegister = false;
    ViewBag.PostController = "Manage";
    ViewBag.PostAction = "Buyer";

    var loginProfile = User.Identity.GetLoginProfile();
}

<!-- CONTENTS -->
<div class="main-content bg-1 padding-top-30 padding-bottom-60">
    <div class="container">
        @Html.Partial("_ProfileInvisibleMessage", loginProfile)

        <div class="row">
            <div class="col-xs-12">
                @Html.Partial("_UserMenu", loginProfile)
                @Html.Partial("_UserCallToAction")
            </div>
            <div class="col-xs-12">
                @Html.Localized("MY_ACCOUNT_LINK", "h3")
                <div class="row">
                    <div class="col-xs-12 col-md-9">
                        @Html.Partial("_BuyerProfileForm", Model)
                    </div>
                    <div class="hidden-xs hidden-sm col-md-3">
                        @Html.Localized("PROFILE_IMAGE", "label")
                        <div class="foto-perfil">
                            <img src="@Model.AvatarUrl" alt="@Model.Name" class="avatar">
                            <a href="#" class="action edit js-change-avatar"><span class="fas fa-pen"></span></a>
                            <a href="#" class="action trash js-remove-avatar"><span class="fas fa-trash"></span></a>
                            <input type="file" id="file" name="file" class="js-avatar-file" style="display: none" />
                        </div>
                        <div class="help-block text-muted">
                            @Html.Localized("PROFILE_IMAGE_UPLOAD_HINT", "small")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    @Html.Partial("_CitiesScript")
    <script>AvatarEditor.init('@Url.ActionLocalized("Change", "Avatar")', '@Url.ActionLocalized("Remove", "Avatar")')</script>
}
