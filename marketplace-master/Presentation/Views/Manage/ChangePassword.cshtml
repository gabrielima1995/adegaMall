@using Microsoft.AspNet.Identity
@model Domain.DTO.ChangePasswordViewModel

@{
    ViewBag.Title = Request.GetLocalizedString("CHANGE_PASSWORD_TITLE");
    var loginProfile = User.Identity.GetLoginProfile();
}

<!-- CONTENTS -->
<div class="main-content bg-1 padding-top-30 padding-bottom-60">
    <div class="container">
        @Html.Partial("_ProfileInvisibleMessage", loginProfile)

        <div class="row">
            <div class="col-xs-12">
                @Html.Partial("_UserMenu", loginProfile)
            </div>
            <div class="col-xs-12">
                @Html.Localized("CHANGE_PASSWORD_TITLE", "h3")

                @using (Html.BeginForm("ChangePassword", "Manage", new { lang = Request.GetCurrentLang() }, FormMethod.Post, new { @class = "form-group margin-top-20", role = "form" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                @Html.LabelFor(i => i.OldPassword)
                                @Html.PasswordFor(i => i.OldPassword, new { @class = "form-control", placeholder = Request.GetLocalizedString("CURRENT_PASSWORD_INPUT") })
                                @Html.ValidationMessageFor(model => model.OldPassword, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                @Html.LabelFor(i => i.NewPassword)
                                @Html.PasswordFor(i => i.NewPassword, new { @class = "form-control", placeholder = Request.GetLocalizedString("NEW_PASSWORD_INPUT") })
                                @Html.ValidationMessageFor(model => model.NewPassword, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                @Html.LabelFor(i => i.ConfirmPassword)
                                @Html.PasswordFor(i => i.ConfirmPassword, new { @class = "form-control", placeholder = Request.GetLocalizedString("CONFIRM_NEW_PASSWORD_INPUT") })
                                @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-9">
                            <div class="form-group">
                                @Html.Localized("CHANGE_PASSWORD_BUTTON", "button", new { type = "submit", @class = "btn btn-primary btn-block" })
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!-- /CONTENTS -->