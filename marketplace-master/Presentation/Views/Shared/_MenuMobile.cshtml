@using Microsoft.AspNet.Identity

@{
    var isAuthenticated = Request.IsAuthenticated;
    var loginProfile = isAuthenticated ? User.Identity.GetLoginProfile() : null;
    var isUser = isAuthenticated && User.Identity.GetLoginProfile().IsBuyerOrSellerOrSellerAssistant();
    var isAdmin = isAuthenticated && User.Identity.GetLoginProfile().IsAdminOrGestao();

    var userConfig = Domain.UserConfig.UserConfiguration.Current;
    var userBlog = Domain.UserConfig.UserConfiguration.Current;
    var blogUrl = userConfig.BlogConfig.GetBlogAddress();

    var currentUrl = Request.Url;
    var config = MaaSConfig.Current;
}

<!-- SIDE MENU MOBILE -->
<div class="side-menu-mobile visible-xs">
    <div class="top"><span class="glyphicon glyphicon-remove"></span></div>
    <ul class="links">
        <li class="mobile-menu-home">
            @Html.Localized("HOME_LINK", "a", new { href = Url.ActionLocalized("Index", "Home") })
        </li>
        @if (blogUrl != null || (userConfig.BlogConfig.Enabled && !string.IsNullOrWhiteSpace(userConfig.BlogConfig.Address)))
        {
            <li class="mobile-menu-blog">
                @Html.Localized("BLOG_LINK", "a", new { href = blogUrl })
            </li>
        }

        @Html.Action("MenuCategorias", "Home", new { mobile = true })

        @foreach (var link in config.AdditionalLinks)
        {
            if ((link?.Enabled).GetValueOrDefault())
            {
                <li class="mobile-menu-extra">
                    @Html.Localized(link.Label, "a", new { href = link.Url, @class = "item-menu" })
                </li>
            }
        }
        @if (!User.Identity.GetLoginProfile().IsBuyer() && config.Search.QuotesSearch.Enabled)
        {
            <li class="mobile-menu-quotesearch">
                @Html.Localized("QUOTE_SEARCH_MENU_LABEL", "a", new { href = Url.ActionLocalized("Search", "Quotes") })
            </li>
        }
        @if (isAuthenticated)
        {
            if (isUser)
            {
                <li class="mobile-menu-account">
                    @Html.Localized("MY_ACCOUNT_LINK", "a", new { href = Url.ActionLocalized("Index", "Manage") })
                    <input type="hidden" id="loginProfileName" value="@loginProfile.Name" />
                    <input type="hidden" id="loginProfileEmail" value="@loginProfile.Email" />
                    <input type="hidden" id="loginProfilePhone" value="@loginProfile.PhoneNumber" />
                </li>
            }
            else if (isAdmin)
            {
                <li class="mobile-menu-admin">
                    <a href="@Url.ActionLocalized("Index", "Sellers", new {area = "Admin"})">Painel Admin</a>
                </li>
            }
        }
        else
        {
            <li class="mobile-menu-login">
                @Html.Localized("LOGIN_LINK", "a", new { href = Url.ActionLocalized("Login", "Account") })
            </li>
            @*<li class="mobile-menu-register-seller">
                <a href="@Url.ActionLocalized("Seller", "Register")" class="menu-btn menu-btn-register">
                    @Html.Localized("SELLER_JOIN_BUTTON_1")
                    @Html.Localized("SELLER_JOIN_BUTTON_2", "small", new { style = "text-transform: uppercase;" })
                </a>
            </li>

            if (config.Buyer.Enabled)
            {
                <li class="mobile-menu-register-buyer">
                    <a href="@Url.ActionLocalized("Buyer", "Register")" class="menu-btn menu-btn-register">
                        @Html.Localized("BUYER_JOIN_BUTTON_1")
                        @Html.Localized("BUYER_JOIN_BUTTON_2", "small", new { style = "text-transform: uppercase;" })
                    </a>
                </li>
            }*@
        }

        @if (config.Product.Enabled && isAuthenticated && loginProfile.IsBuyer())
        {
            <li class="mobile-menu-cart btnCart">
                <a href="@Url.ActionLocalized("Index", "Cart")" class="menu-btn menu-btn-cart" title="Ver carrinho de compras">
                    <i class="fa fa-shopping-cart"></i>
                    @Html.Localized("CART_BUTTON")
                    <span class="badge js-cart-qty">0</span>
                </a>
            </li>
        }

        @if (Request.IsAuthenticated)
        {
            <li class="mobile-menu-logoff">
                @using (Html.BeginForm("LogOff", "Account", new { lang = Request.GetCurrentLang() }, FormMethod.Post, new { id = "logoutForm" }))
                {
                    @Html.AntiForgeryToken()

                    <a href="javascript:document.getElementById('logoutForm').submit()" class="item-menu">
                        @Html.Localized("LOGOUT_LINK", "span")
                    </a>
                }
            </li>
        }

        @if (LanguagesHelper.ActiveLanguages.Count > 1)
        {
            foreach (var lang in LanguagesHelper.ActiveLanguages)
            {
                <li class="mobile-menu-lang">
                    <a href="@currentUrl.GetNewUrlLocalized(lang.Specifier)" title="@lang.NativeName" class="mobile-lang-@lang.Specifier">
                        <img width="30" height="20" alt="@lang.NativeName" src="@lang.FlagImage" />
                    </a>
                </li>
            }
        }
    </ul>
</div>
