@model Domain.Entities.IWithCategory
@{
    bool isMobile = Presentation.Helpers.BrowserHelper.IsMobileBrowser();
}

@Html.DropDownListFor(m => m.Category,
    new SelectList(Model.Categories, "Id", "Name", Model.Category),
    (ViewData.ContainsKey("NoDefaultCategory") ? null : Request.GetLocalizedString("CATEGORY_SELECT")),
    new { @class = isMobile ? "form-control js-category" : "form-control js-category js-select" })

@Html.ValidationMessageFor(model => model.Category, "", new { @class = "text-danger" })
