@using Presentation.Helpers
@model Application.Home.SellersSearchHomeViewModel

@{
    var config = MaaSConfig.Current;
    bool portfolio = config.Search.SearchType == Domain.Config.General.SearchType.Portfolio;
    int fieldCount = 0;
    if (config.Search.SearchFields.Query)
    {
        fieldCount++;
    }
    if (config.Search.SearchFields.Category)
    {
        fieldCount++;
    }
    if (config.Search.SearchFields.Location)
    {
        fieldCount++;
    }
    var fieldClass = $"col-xs-12 {Css.If(fieldCount > 2, "col-md-4", "col-md-6")}";
}

@if (config.Search.Enabled)
{
    using (Html.BeginForm("Index", "Search", FormMethod.Get, new { id = "searchForm", name = "search_home", @class = "container-fluid" }))
    {
        if (config.Search.SearchFields.Location)
        {
            <div class="row">
                <div class="col-xs-12">
                    @Html.Partial("_GoogleMapsAutocomplete")
                </div>
            </div>
        }

        <div class="row">
            @if (config.Search.SearchFields.Query)
            {
                <div class="@fieldClass">
                    <div class="form-group">
                        @Html.TextBox("Query", null, new { @class = "form-control", placeholder = Request.GetLocalizedString(portfolio ? "PORTFOLIO_FILTER_INPUT" : "SELLER_FILTER_INPUT") })
                    </div>
                </div>
            }


            @if (config.Search.SearchFields.Category)
            {
                <div class="@fieldClass">
                    <div class="form-group">
                        @Html.Partial("_CategoriesSelect", Model)
                    </div>
                </div>

                <div class="@fieldClass">
                    <div class="form-group">
                        @Html.Partial("_SubCategoriesSelect", Model)
                    </div>
                </div>
            }
        </div>


        <div class="row margin-top-10 margin-bottom-default text-center">
            <div class="col-xs-12">
                <button type="submit" class="btn home-hero-main-btn">
                    @Html.Localized(portfolio ? "FIND_PORTFOLIO_BUTTON" : "FIND_SELLER_BUTTON")
                    <i class="fa fa-search"></i>
                </button>
            </div>
        </div>
    }
}

@if (config.Quote.Enabled && config.Quote.GeneralQuote.Enabled)
{
    <div class="row text-center">
        <div class="col-xs-12">
            @Html.Localized("GENERAL_QUOTE_BUTTON", "a", new { href = Url.ActionLocalized("Request", "Quotes"), @class = "home-hero-second-btn" })
        </div>
    </div>
}
