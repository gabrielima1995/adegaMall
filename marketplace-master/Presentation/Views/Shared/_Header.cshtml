@using Domain.DTO
@using Microsoft.AspNet.Identity
@using Presentation.Helpers

@{
    var isAuthenticated = Request.IsAuthenticated;
    var loginProfile = User.Identity.GetLoginProfile() ?? new LoginProfile();
    var isUser = isAuthenticated && loginProfile.IsBuyerOrSellerOrSellerAssistant();
    var isAdmin = isAuthenticated && loginProfile.IsAdminOrGestao();

    var currentUrl = Request.Url;
    var config = MaaSConfig.Current;

    var isHome = Request.Url.LocalPath == "/";
    var userConfig = Domain.UserConfig.UserConfiguration.Current;
    var blogUrl = userConfig.BlogConfig.GetBlogAddress();
}

<!-- STRIP -->
<div class="strip">
    <div class="container">
        <div class="row">
            <div class="col-xs-12 strip-content-1">
                <div class="strip-text">Olá, seja bem vindo ao maior marketplace de bebidas do Brasil!</div>

                <div class="strip-links-wrapper">
                    <div class="strip-links">
                        @if (!loginProfile.IsBuyer() && config.Search.QuotesSearch.Enabled)
                        {
                            <a class="strip-link" href="@Url.ActionLocalized("Search", "Quotes")">
                                @Html.Localized("QUOTE_SEARCH_MENU_LABEL")
                            </a>
                        }

                        @if (isAuthenticated)
                        {
                            if (isUser)
                            {
                                <a class="strip-link" href="@(loginProfile.IsBuyer() ? Url.AddLang(config.Buyer.MainPageUrl) : Url.AddLang(config.Seller.MainPageUrl))">
                                    @Html.Localized("MY_ACCOUNT_LINK")
                                </a>
                                <input type="hidden" id="loginProfileName" value="@loginProfile.Name" />
                                <input type="hidden" id="loginProfileEmail" value="@loginProfile.Email" />
                                <input type="hidden" id="loginProfilePhone" value="@loginProfile.PhoneNumber" />
                            }
                            else if (isAdmin)
                            {
                                <a class="strip-link" href="@Url.ActionLocalized("Index", "Sellers", new {area = "Admin"})">
                                    <strong>Painel Admin</strong>
                                </a>
                            }

                            using (Html.BeginForm("LogOff", "Account", new { lang = Request.GetCurrentLang() }, FormMethod.Post, new { id = "logoutFormTop" }))
                            {
                                @Html.AntiForgeryToken()

                                <a class="strip-link" href="javascript:document.getElementById('logoutFormTop').submit()">
                                    @Html.Localized("LOGOUT_LINK", "strong")
                                </a>
                            }
                        }
                        else
                        {
                            <a class="strip-link" href="@Url.ActionLocalized("Buyer", "Register")">
                                @Html.Localized("BUYER_JOIN_BUTTON_FULL", "strong")
                            </a>
                            <a class="strip-link" href="@Url.ActionLocalized("Login", "Account")">
                                @Html.Localized("LOGIN_LINK", "strong")
                            </a>
                        }
                    </div>
                    <div class="strip-social-links">
                        <a class="strip-social-link" href="https://www.facebook.com/adegamall/" title="Facebook da Adega Mall">
                            <i class="fab fa-facebook-square"></i>
                        </a>
                        <a class="strip-social-link" href="https://www.instagram.com/adegamall/" title="Instagram da Adega Mall">
                            <i class="fab fa-instagram"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 strip-content-2">
                <a href="@Url.ActionLocalized("Index", "Cart")" class="cart-menu-btn" title="Ver carrinho de compras">
                    <i class="fa fa-shopping-cart cart-icon"></i>
                    <span class="badge js-cart-qty">0</span>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- MENU -->
