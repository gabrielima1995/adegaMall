{
    <div class="form-group">
        @Html.LabelFor(i => i.GooglePlusProfile)
        @Html.TextBoxFor(i => i.GooglePlusProfile, new { @class = "form-control", placeholder = Request.GetLocalizedString("GOOGLEPLUS_PROFILE_URL") })
        @Html.ValidationMessageFor(model => model.GooglePlusProfile, "", new { @class = "text-danger" })
        @Html.HiddenFor(i => i.GooglePlusProfileRequired)
    </div>
}

@if (config.Seller.WhatsAppNumber.Enabled)
{
    <div class="form-group">
        @Html.LabelFor(i => i.WhatsAppNumber)
        @Html.TextBoxFor(i => i.WhatsAppNumber, new { @class = "form-control wpp-phone-input", placeholder = Request.GetLocalizedString("PHONE_INPUT") })
        @Html.ValidationMessageFor(model => model.WhatsAppNumber, "", new { @class = "text-danger" })
        @Html.HiddenFor(i => i.WhatsAppNumberRequired)
    </div>
}

@if (config.Seller.Address.Enabled || Model.AddressRequired)
{
    <hr />
    @Html.Localized("ADDRESS_LABEL", "h4")

    <div id="changeAddressContainer">
        <div class="row">
            <div class="col-xs-12">
                <p><small><a href="javascript:void(0)" id="btnChangeAddress">Alterar endereço</a></small></p>
            </div>
        </div>
    </div>

    <div id="addressAutocompleteContainer">
        <div class="row">
            <div class="col-xs-12">
                <div class="form-group">
                    <input type="text" id="txtAddrAutocomplete" class="form-control" placeholder="@Request.GetLocalizedString("ADDRESS_INPUT")" />
                    @Html.HiddenFor(i => i.AddressLat)
                    @Html.HiddenFor(i => i.AddressLng)
                    @Html.Localized("GOOGLE_ADDRESS_INPUT_HELP", "small", new { @class = "help-block text-muted" })
                </div>
            </div>
        </div>
    </div>

    <div id="addressFieldsContainer">
        <div class="row">
            <div class="col-xs-12 col-sm-9">
                <div class="form-group">
                    @if (isManagePage)
                    {
                        @:@Html.TextBoxFor(i => i.Address, new { @class = "form-control input-sm", placeholder = Request.GetLocalizedString("ADDRESS_INPUT"), disabled = "disabled" })
                    }
                    else
                    {
                        @:@Html.TextBoxFor(i => i.Address, new { @class = "form-control input-sm", placeholder = Request.GetLocalizedString("ADDRESS_INPUT") })
                    }
                    @Html.HiddenFor(i => i.Address)
                    @Html.ValidationMessageFor(model => model.Address, "", new { @class = "text-danger" })
                    @Html.HiddenFor(i => i.AddressRequired)
                </div>
            </div>

            <div class="col-xs-12 col-sm-3">
                <div class="form-group">
                    @if (isManagePage)
                    {
                        @:@Html.TextBoxFor(i => i.AddressNumber, new { @class = "form-control input-sm", placeholder = Request.GetLocalizedString("ADDRESS_NUMBER_INPUT"), disabled = "disabled" })
                    }
                    else
                    {
                        @:@Html.TextBoxFor(i => i.AddressNumber, new { @class = "form-control input-sm", placeholder = Request.GetLocalizedString("ADDRESS_NUMBER_INPUT") })
                    }
                    @Html.HiddenFor(i => i.AddressNumber)
                    @Html.ValidationMessageFor(model => model.AddressNumber, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-xs-12 col-sm-4">
                <div class="form-group">
                    @Html.TextBoxFor(i => i.AddressAdditionalInfo, new { @class = "form-control input-sm", placeholder = Request.GetLocalizedString("ADDRESS_ADDITIONAL_INFO_INPUT") })
                    @Html.ValidationMessageFor(model => model.AddressAdditionalInfo, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="col-xs-12 col-sm-4">
                <div class="form-group">
                    @if (isManagePage)
                    {
                        @:@Html.TextBoxFor(i => i.AddressNeighborhood, new { @class = "form-control input-sm", placeholder = Request.GetLocalizedString("NEIGHBORHOOD_INPUT"), disabled = "disabled" })
                    }
                    else
                    {
                        @:@Html.TextBoxFor(i => i.AddressNeighborhood, new { @class = "form-control input-sm", placeholder = Request.GetLocalizedString("NEIGHBORHOOD_INPUT") })
                    }
                    @Html.HiddenFor(i => i.AddressNeighborhood)
                    @Html.ValidationMessageFor(model => model.AddressNeighborhood, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="col-xs-12 col-sm-4">
                <div class="form-group">
                    @if (isManagePage)
                    {
                        @:@Html.TextBoxFor(i => i.AddressZipCode, new { @class = "form-control js-zipcode input-sm", placeholder = Request.GetLocalizedString("ZIPCODE_INPUT"), disabled = "disabled" })
                    }
                    else
                    {
                        @:@Html.TextBoxFor(i => i.AddressZipCode, new { @class = "form-control js-zipcode input-sm", placeholder = Request.GetLocalizedString("ZIPCODE_INPUT") })
                    }
                    @Html.HiddenFor(i => i.AddressZipCode)
                    @Html.ValidationMessageFor(model => model.AddressZipCode, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="form-group">
            @Html.Partial("_CitiesSelect", Model)
            @Html.HiddenFor(i => i.CityAndStateRequired)
        </div>

        <div id="addressMap" style="width: 100%; height: 200px; display: @(isManagePage ? "none" : "block")"></div>
    </div>
    @Html.HiddenFor(Model => Model.RequireModeration)
}

@if (ViewBag.AllFields || ViewBag.CompleteRegister)
{
    <hr />
    <div class="row">
        <div class="col-xs-12">
            <div class="form-group">
                @Html.LabelFor(model => model.PreferredTimeZoneId)
                @Html.DropDownList("PreferredTimeZoneId", null, new { @class = "form-control" })
            </div>
        </div>
    </div>
}