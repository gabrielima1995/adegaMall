@model Application.Sellers.SellerGatewayViewModel

@{
    var config = MaaSConfig.Current;

    ViewBag.PersonCities = new Dictionary<string, string>(1);
    ViewBag.CompanyCities = new Dictionary<string, string>(1);

    if (!string.IsNullOrWhiteSpace(Model.Moip?.Person?.Address?.CityAndState))
    {
        ViewBag.PersonCities.Add(Model.Moip.Person.Address.CityAndState, Model.Moip.Person.Address.CityAndState);
    }

    if (!string.IsNullOrWhiteSpace(Model.Moip?.Company?.Address?.CityAndState))
    {
        ViewBag.CompanyCities.Add(Model.Moip.Company.Address.CityAndState, Model.Moip.Company.Address.CityAndState);
    }
}

@Html.HiddenFor(model => model.Moip.Enabled)
@Html.HiddenFor(model => model.Moip.Person.Enabled)
@Html.HiddenFor(model => model.Moip.Person.Address.Enabled)
@Html.HiddenFor(model => model.Moip.Company.Enabled, new { @class = "js-moip-seller-company-enabled" })
@Html.HiddenFor(model => model.Moip.Company.Address.Enabled, new { @class = "js-moip-seller-company-address-enabled" })
@Html.HiddenFor(model => model.Moip.BankAccount.Enabled)
@Html.HiddenFor(model => model.GatewayRegistered)

@if (!Model.GatewayRegistered)
{
    @:@Html.Localized("PAGARME_REGISTRATION_TEXT", "p")
}

@Html.ValidationSummary(false, "", new { @class = "text-danger" })

<div class="row">
    <div class="col-xs-12">
        @Html.LabelFor(model => model.Moip.HasCompany)

        <div class="radio">
            <label>
                @Html.RadioButtonFor(model => model.Moip.HasCompany, false)
                @Request.GetLocalizedString("MOIP_SELLER_HASCOMPANY_PERSON_OPTION")
            </label>
        </div>
        <div class="radio">
            <label>
                @Html.RadioButtonFor(model => model.Moip.HasCompany, true)
                @Request.GetLocalizedString("MOIP_SELLER_HASCOMPANY_COMPANY_OPTION")
            </label>
        </div>
    </div>
</div>

<br />

