@model Presentation.Views.Products.Cart.CheckoutConfirmationViewModel

@{
    ViewBag.Title = Request.GetLocalizedString(Model.IsPendingPayment ? "CHECKOUT_CONFIRMATION_PENDING_PAYMENT_TITLE" : "CHECKOUT_CONFIRMATION_TITLE");
}

<div class="main-content bg-1 padding-top-30 padding-bottom-0">
    <div class="container">
        <div class="row margin-bottom-30">
            <div class="col-xs-12 col-md-6 col-md-offset-3">
                <div class="panel panel-default text-center">
                    <div class="panel-body">
                        <h2>
                            <i class="glyphicon glyphicon-ok"></i>
                            @ViewBag.Title
                        </h2>
                        <hr />
                        @Html.Localized(Model.IsPendingPayment ? "CHECKOUT_CONFIRMATION_PENDING_PAYMENT_MESSAGE" : "CHECKOUT_CONFIRMATION_MESSAGE", "p")
                        @Html.Localized("CHECKOUT_UPDATES_INFO", "p")

                        @if (Model.HasMultipleSellers)
                        {
                            @Html.Localized("CHECKOUT_MULTIPLE_SELLERS_INFO", "p")
                        }

                        @if (Model.IsBoleto)
                        {
                            <div class="alert alert-info">
                                @Html.Localized("CART_BOLETO_TITLE", "h5")
                                @Html.Localized("CART_BOLETO_INFO", "p")

                                <ul class="list-unstyled">
                                    @foreach (var order in Model.Orders)
                                    {
                                        <li><a target="_blank" href="@(order.Transaction?.BoletoUrl)">@(order.Transaction?.BoletoUrl)</a></li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (Model.IsOfflinePayment)
                        {
                            <div class="alert alert-info">
                                @Html.Localized("CHECKOUT_CONFIRMATION_OFFLINE_PAYMENT_TITLE", "h5")
                                @Html.Localized("CHECKOUT_CONFIRMATION_OFFLINE_PAYMENT_INFO", "p")
                            </div>
                        }
                    </div>
                    <ul class="list-group">
                        @foreach (var order in Model.Orders)
                        {
                            <li class="list-group-item">
                                @Request.GetLocalizedString("ORDER_LABEL")
                                <a href="@Url.ActionLocalized("Details", "MyOrders", new { id = order.Id })">#@order.Id.DisplayShortGuid()</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>


@section scripts{
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }

        document.addEventListener('DOMContentLoaded', function() {
            executeTrackEcommerce();
        });

        function executeTrackEcommerce() {
            if (window.gtag) {
                trackEcommerce();
            } else {
                setTimeout(executeTrackEcommerce, 1000);
            }
        }

        function trackEcommerce() {
            console.log('Tracking ecommerce');

            gtag('event', 'conversion', {
                'send_to': 'AW-467456743/zBCpCLvU3uwBEOel894B',
                'transaction_id': ''
            });

            console.log('Tracking ecommerce OK');
        }
    </script>
}