@model ProductPageVM

@{
    var config = MaaSConfig.Current;

    var searchUrl = config.Search.SearchType == Domain.Config.General.SearchType.Product
        ? Url.ActionLocalized("Search", "Products")
        : Url.ActionLocalized("Index", "Search");
}

<div class="row product-top-actions-bar">
    <div class="col-xs-12">
        <p>
            @if (config.Search.Enabled)
            {
                <a href="@searchUrl" class="product-top-actions-bar-search">
                    <small>
                        &lsaquo;
                        @Request.GetLocalizedString("PRODUCT_SEARCH_TITLE")
                    </small>
                </a>
            }

            @if (config.Product.Category.Enabled && Model.Product.Category != null)
            {
                <small class="product-top-actions-bar-category" title="@Request.GetLocalizedString("PRODUCT_CATEGORIES_TITLE")">| @Model.Product.Category.Name</small>
            }

            <a href="@Url.ActionLocalized("Seller", "Register")" class="product-top-actions-bar-register-seller pull-right">
                <small>
                    @Request.GetLocalizedString("SELLER_WANNA_SELL_TOO")
                </small>
            </a>
        </p>
    </div>
</div>
