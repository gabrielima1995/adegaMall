@using Domain.Entities.StoreModule
@model Presentation.Models.StoreVM

@{
    ViewBag.Title = Request.GetLocalizedString("MY_STORE_TITLE");
    ViewBag.IsLiable = Model.IsLiable;
    ViewBag.AmountFee = Model.AmountFee;
    ViewBag.PercentFee = Model.PercentFee;
    var viewPathFmt = "~/Views/Products/Store/{0}.cshtml";
    var config = MaaSConfig.Current;
    var loginProfile = User.Identity.GetLoginProfile();
}

@section styles
{
    @Styles.Render("~/Content/datatable")
}

<div class="main-content bg-1 padding-top-30 padding-bottom-60">
    <div class="container">
        @Html.Partial("_ProfileInvisibleMessage", loginProfile)

        <div class="row">
            <div class="col-xs-12">
                @Html.Partial("_UserMenu", loginProfile)
            </div>
            <div class="col-xs-12">
                @Html.Partial(string.Format(viewPathFmt, "_Products"))

                @if (config.Product.Enabled && config.Product.ShippingMode == ShippingMode.PerStore)
                {
                    <hr />
                    @Html.Localized("STORE_SETTINGS_TITLE", "h3")

                    <div class="m-b-md">
                        @using (Html.BeginForm("Index", "Store", new { lang = Request.GetCurrentLang() }, FormMethod.Post, new { @class = "" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(model => model.SellerId)

                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            if (config.Product.OnSitePickupShipping.Enabled)
                            {
                                <div class="row">
                                    <div class="col-xs-12">
                                        <div class="checkbox">
                                            <label>
                                                @Html.CheckBoxFor(i => i.OnSitePickupEnabled)
                                                @Request.GetLocalizedString("STORE_ON_SITE_PICKUP_METHOD_INPUT")
                                            </label>
                                            @Html.ValidationMessageFor(model => model.OnSitePickupEnabled, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            }

                            if (config.Product.AsapLogShipping.Enabled)
                            {
                                <div class="row">
                                    <div class="col-xs-12">
                                        <div class="checkbox">
                                            <label>
                                                @Html.CheckBoxFor(i => i.AsapLogEnabled)
                                                @Request.GetLocalizedString("STORE_ASAPLOG_METHOD_INPUT")
                                            </label>
                                            @Html.ValidationMessageFor(model => model.AsapLogEnabled, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-xs-12 col-sm-6 col-md-4">
                                        <div class="input-group form-group">
                                            <span class="input-group-addon">Usuário</span>
                                            @Html.TextBoxFor(model => model.AsapLogUser, new { @class = "form-control" })
                                        </div>
                                        @Html.ValidationMessageFor(model => model.AsapLogUser, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="col-xs-12 col-sm-6 col-md-4">
                                        <div class="input-group form-group">
                                            <span class="input-group-addon">Senha</span>
                                            @Html.TextBoxFor(model => model.AsapLogPassword, new { @class = "form-control", type = "password" })
                                        </div>
                                        @Html.ValidationMessageFor(model => model.AsapLogPassword, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            }

                            if (config.Product.PrivateFleetShipping.Enabled)
                            {
                                <div class="row margin-bottom-10">
                                    <div class="col-xs-12 col-sm-8">
                                        <div class="checkbox">
                                            <label>
                                                @Html.CheckBoxFor(i => i.SingleFreightEnabled)
                                                @Request.GetLocalizedString("STORE_SINGLE_FREIGHT_METHOD_INPUT")
                                            </label>

                                            @Html.ValidationMessageFor(model => model.SingleFreightEnabled, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="js-single-freight" style="display: @(Model.SingleFreightEnabled ? "block" : "none")">
                                            <div class="js-single-freight-params-container">
                                                @foreach (var sfp in Model.SingleFreightParams)
                                                {
                                                    @Html.Partial(string.Format(viewPathFmt, "_SingleFreightParameter"), sfp)
                                                }
                                            </div>

                                            @Html.ValidationMessageFor(model => model.SingleFreightParams, "", new { @class = "text-danger" })

                                            <button type="button" class="btn btn-default js-single-freight-param-add-button @Css.DisabledForSellerAssistant(loginProfile, SellerAssistantPermissions.StoreEdit)">
                                                <i class="glyphicon glyphicon-plus"></i>
                                                @Request.GetLocalizedString("STORE_SINGLE_FREIGHT_PARAM_ADD_BUTTON")
                                            </button>
                                        </div>

                                    </div>
                                </div>
                            }

                            if (config.Product.SedexShipping.Enabled || config.Product.PACShipping.Enabled)
                            {
                                <div class="row">
                                    @if (config.Product.SedexShipping.Enabled)
                                    {
                                        <div class="col-xs-12 col-sm-4">
                                            <div class="checkbox">
                                                <label>
                                                    @Html.CheckBoxFor(i => i.SedexEnabled)
                                                    @Html.DisplayNameFor(model => model.SedexEnabled)
                                                </label>

                                                @Html.ValidationMessageFor(model => model.SedexEnabled, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    }

                                    @if (config.Product.PACShipping.Enabled)
                                    {
                                        <div class="col-xs-12 col-sm-4">
                                            <div class="checkbox">
                                                <label>
                                                    @Html.CheckBoxFor(i => i.PacEnabled)
                                                    @Html.DisplayNameFor(model => model.PacEnabled)
                                                </label>

                                                @Html.ValidationMessageFor(model => model.PacEnabled, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="row">
                                <div class="col-xs-12">
                                    @Html.Localized("SAVE_CHANGES_BUTTON", "button", new { type = "submit", @class = $"btn btn-primary btn-block {Css.DisabledForSellerAssistant(loginProfile, SellerAssistantPermissions.StoreEdit)}" })
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts
{
    @Scripts.Render("~/bundles/datatable")

    <script>
        var addSingleFreightParamUrl = '@Url.ActionLocalized("AddSingleFreightParam", "Store")';
        var singleFreightEnabledSelector = '#@(nameof(Model.SingleFreightEnabled))';
        StoreSingleFreightParams.init(addSingleFreightParamUrl, singleFreightEnabledSelector);
    </script>

    <script>
        var hideCurrentStock = @config.Product.Stock.HideCurrentStock.Enabled.ToString().ToLower();
        StoreIndex.init(hideCurrentStock);
        $(".js-tooltip").tooltip();
    </script>
}
