<div class="modal" tabindex="-1" role="dialog" id="modalDeleteProductAlert">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" style="color:red">@Html.Localized("STORE_MODAL_DELETE_TITLE")</h5>
            </div>
            <div class="modal-body">
                @Html.Localized("STORE_MODAL_DELETE_BODY", "p")
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">
                    @Html.Localized("STORE_MODAL_DELETE_DISMISS")
                </button>
                <a id="deleteProduct" type="button" class="btn btn-info confirm-delete-product" href="">
                    @Html.Localized("STORE_MODAL_DELETE_ACCEPT")
                </a>
            </div>
        </div>
    </div>
</div>
