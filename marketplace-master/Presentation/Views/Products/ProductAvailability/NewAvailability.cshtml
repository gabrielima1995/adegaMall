@using Microsoft.AspNet.Identity

@model Presentation.Models.ProductViewModels.ProductAvailabilityVM

@{
    ViewBag.Title = Request.GetLocalizedString("NEW_PRODUCT_AVAILABILITY_TITLE");

    var viewPathFmt = "~/Views/Products/ProductAvailability/{0}.cshtml";
    var loginProfile = User.Identity.GetLoginProfile();
}
<!-- CONTENTS -->
<div class="main-content bg-1 padding-top-30 padding-bottom-60">
    <div class="container">
        @Html.Partial("_ProfileInvisibleMessage", loginProfile)

        <div class="row">
            <div class="col-xs-12">
                @Html.Partial("_UserMenu", loginProfile)
            </div>
            <div class="col-xs-2">
            </div>
            <div class="col-xs-8">
                <h3>@ViewBag.Title</h3>
                @Html.Localized("PRODUCT_AVAILABILITY_INFO", "p")
                @Html.Partial(string.Format(viewPathFmt, "_NewAvailabilityForm"))
            </div>
        </div>
    </div>
</div>
<!-- /CONTENTS -->

@section scripts
{
    <script>
        (function ($, MaaS) {
            $(document).ready(function () {
                var calculateEndTime = @(Model.EndTimeDisabled ? "1" : "0");
                var endTimeInterval = '@(Model.EndTimeInterval?.ToString(@"hh\:mm") ?? "")';

                ProductAvailabilityCore.init(calculateEndTime, endTimeInterval);
            });
        })(window.jQuery, window.MaaS);
    </script>
}