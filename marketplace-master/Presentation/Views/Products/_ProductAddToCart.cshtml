@using System.Globalization
@using Domain.Modules.StoreModule.Entities
@using Domain.Entities.StoreModule
@using Presentation.Helpers

@model ProductPageVM

@{
    var config = MaaSConfig.Current;
    var bmIsSale = config.Product.BusinessModel.Sale.Enabled;
    var bmIsRental = config.Product.BusinessModel.Rental.Enabled;
    var showQtyBox = (bmIsSale && config.Product.Page.Quantity.Enabled) || (bmIsRental && config.Product.BusinessModel.Rental.QuantityEnabled);

    var showMultiplierBox =
        config.Product.BusinessModel.Rental.EnablePriceMultiplier &&
        Model.Product.MinMultiplier.HasValue &&
        Model.Product.MaxMultiplier.GetValueOrDefault() > 0 &&
        Model.Product.MultiplierPrice.GetValueOrDefault() > 0;

    var showStockVariant =
        config.Product.BusinessModel.Sale.Enabled &&
        config.Product.Variants.Enabled &&
        config.Product.Variants.StockByVariantEnabled &&
        Model.Product.StockByVariant;

    var showRecurringAvailabilities =
        bmIsRental &&
        Model.RecurringProductAvailabilityEnabled &&
        Model.IsPackageProduct &&
        Model.RecurringAvailabilities != null &&
        Model.RecurringAvailabilities.Count > 0;

    ViewBag.DisableGridViewAutoLoading = showRecurringAvailabilities;
    ViewBag.ForceSelectPeriod = showRecurringAvailabilities;

    DateTime startDate;

    if (ViewBag.StartDate == null)
    {
        startDate = DateTime.Today;
    }
    else
    {
        startDate = (DateTime)ViewBag.StartDate;
    }
}

@functions {
    string GenerateRecurringAvailabilityGridUrl(Guid productAvailabilityId)
    {
        DateTime startDate;

        if (ViewBag.StartDate == null)
        {
            startDate = DateTime.Today;
        }
        else
        {
            startDate = (DateTime)ViewBag.StartDate;
        }

        return Url.Action("RentalGrid", "Products", new { productId = Model.Product.Id, year = startDate.Year, month = startDate.Month, day = startDate.Day, productAvailabilityId, forceSelectPeriod = ViewBag.ForceSelectPeriod, start = ViewBag.StartDate?.ToString("yyyy-MM-dd"), time = ViewBag.StartTime });
    }
}

@if (config.Product.Enabled)
{
    if (!Model.IsOutOfStock)
    {
        <input type="hidden" name="ProductId" id="ProductId" value="@Model.Product.Id" />
        <input type="hidden" name="IsFixedRental" id="IsFixedRental" value="@Model.IsFixedRental.ToString()" />

        <div class="row">
            <div class="col-xs-12">
                @if (showRecurringAvailabilities)
                {
                    @Html.Localized("PRODUCT_PAGE_RECURRING_AVAILABILITY_TITLE", "strong", new { @class = "text-muted" })

                    foreach (var item in Model.RecurringAvailabilities)
                    {
                        var unitDescription = item.Recurring_Unit.GetDescriptionLocalized();
                        var daysOfWeekDescription = string.Empty;

                        if (item.Recurring_Unit == RecurringProductAvailabilityUnit.Weeks)
                        {
                            var daysOfWeekLabels = item.Recurring_DaysOfWeek.Select(i => i.ToString().ToUpper() + "_LABEL");
                            daysOfWeekDescription = " (" + string.Join(", ", daysOfWeekLabels.Select(i => Request.GetLocalizedString(i).Substring(0, 3))) + ") ";
                        }

                        var title = $"{Request.GetLocalizedString("RECURRING_PRODUCT_AVAILABILITY_UNIT_PREFIX_LABEL")} {item.Recurring_UnitValue} {unitDescription}{daysOfWeekDescription}, {item.StartTime:hh\\:mm} - {item.EndTime:hh\\:mm}";

                        <div class="radio">
                            <label>
                                <input type="radio" name="RecurringAvailabilities"
                                       value="@item.Id" @(ViewBag.ProductAvailabilityId == item.Id ? "checked" : string.Empty)
                                       class="js-rental-grid-load-option"
                                       data-grid-url="@GenerateRecurringAvailabilityGridUrl(item.Id)" />
                                @title
                            </label>
                        </div>
                    }
                }

                @Html.Partial("_RentalSelectPeriod", Model)

                <div id="addToCartContainer">
                    @if (showMultiplierBox)
                    {
                        <div class="form-group">
                            @Html.Localized("CHECKOUT_MULTIPLIER_LABEL", "label")
                            <div class="input-group">
                                @Html.TextBoxFor(model => model.Multiplier, new { id = "js-multiplier", @class = "form-control", type = "number", min = Model.Product.MinMultiplier.ToString(), max = Model.Product.MaxMultiplier.ToString() })
                                <span class="input-group-addon"><i class="fas fa-times"></i>&ensp;@config.DefaultCurrency <span id="js-multiplier-price-base">@Model.Product.MultiplierPrice.Value.RoundTo2Places()</span></span>
                                <span class="input-group-addon"><i class="fas fa-equals"></i> @config.DefaultCurrency <span id="js-additional-total">0,00</span></span>
                            </div>
                            <i class="fas fa-info-circle"></i>
                            <span class="text-warning">@string.Format(Request.GetLocalizedString("CHECKOUT_MULTIPLIER_NOTE"), Model.Product.MinMultiplier, Model.Product.MaxMultiplier)</span>
                        </div>
                    }

                    @if (showStockVariant)
                    {
                        var stockVariants = Model.GetStockVariants();
                        if (!Model.NeedDropDownListForVariants)
                        {
                            <div class="form-group clearfix">
                                <strong class="text-muted">@Model.Product.StockVariantType.Name</strong>:

                                <ul class="box-list">
                                    @foreach (var stockVariant in stockVariants)
                                    {
                                        var htmlAttrs = new Dictionary<string, object>();
                                        var isChecked = Model.VariantIsChecked(stockVariant);

                                        if (!stockVariant.HasStock)
                                        {
                                            htmlAttrs.Add("disabled", "disabled");
                                        }

                                        <li>
                                            <label class="box">
                                                @Html.RadioButton("StockVariant", stockVariant.Variant.Id, isChecked, htmlAttrs)
                                                <span class="checkmark">@stockVariant.Variant.Name</span>
                                            </label>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="form-group clearfix">
                                <strong class="text-muted">@Model.Product.StockVariantType.Name</strong>:
                                <div>
                                    @Html.DropDownList("StockVariant", null, new { @class = "form-control js-select", @name = "StockVariant" })
                                </div>
                            </div>
                        }
                    }

                    @if (config.CustomFields.CartItem.Enabled)
                    {
                        <div class="row">
                            <div class="col-xs-12">
                                @for (int i = 0; i < Model.CartItemCustomFields.CustomFieldDefinitions.Count; i++)
                                {
                                    <div class="form-group">
                                        @{
                                            ViewData["Index"] = i;
                                            Write(Html.Partial("_CustomFieldForms", Model.CartItemCustomFields, ViewData));
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (showQtyBox)
                    {
                        <div class="form-group">
                            @Html.Localized("CART_ITEM_QUANTITY_LABEL", "strong", new { @class = "text-muted" }):
                            <div class="input-group">
                                @Html.TextBox("Quantity", 1, new { @class = "form-control input-lg", type = "number", min = 1 })
                                <div class="input-group-btn">@AddToCartButton()</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        @Html.Hidden("Quantity", 1)
                        <div class="row">
                            <div class="col-sm-12" style="margin-bottom: 1rem">@AddToCartButton()</div>
                        </div>
                    }
                </div>

                <div id="rentalAddedInfoBox" class="alert alert-success" style="display: none">
                    <i class="fa fa-check"></i>
                    Sua locação
                    começará em 10/02 (sáb) às 18:00 e
                    terminará em 16/02 (sex) às 18:00
                </div>

                <p id="productsInCartMsg" style="display: none">
                    <i class="fa fa-shopping-cart"></i>
                    <span class="text-success"><span class="js-count"></span> @Html.Localized("PRODUCTS_IN_CART")</span>
                    <a href="@Url.ActionLocalized("Index", "Cart")" class="btn btn-default">@Html.Localized("PROCEED_TO_CHECKOUT")</a>
                </p>
            </div>
        </div>
    }
    else
    {
        @Html.Localized("PRODUCT_DETAILS_OUT_OF_STOCK", "p", new { @class = "text-danger" })
    }
}

@helper AddToCartButton()
{
    var isBuyer = User.Identity.GetLoginProfile().IsBuyer();
    <a href="javascript:void(0)" data-url="@Css.If(isBuyer, @Url.ActionLocalized("AddItem", "Cart", new { id = Model.Product.Id, area = "" }), Url.ActionLocalized("AddItemAndProceedToLogin", "Cart", new { id = Model.Product.Id, area = "" }))" class="btn btn-lg btn-primary js-cart-add-item" data-loading-text="@Request.GetLocalizedString("LOADING_TEXT")">
        <i class="glyphicon glyphicon-plus"></i>
        @Html.Localized("PRODUCT_ADD_CART_BUTTON")
    </a>
}