@model Application.Modules.Products.Search.SearchViewModel

@if (Model.Total > 0)
{
    if (Model.Facets.Count > 0)
    {
        <div class="search-result-facets-expand visible-xs m-b-sm">
            <a href="javascript:void(0)" class="btn btn-default">
                <i class="glyphicon glyphicon-chevron-down"></i>
                @Html.Localized("SEARCH_FILTERS_FACETS")
            </a>
        </div>
        <form id="frmFacets" action="@Request.Url" method="get" class="search-result-facets-form hidden-xs">
            @QueryParamsAsHiddenFields()

            <div class="list-group">
                @foreach (var group in Model.Facets)
                {
                    <div class="list-group-item">
                        <h4 class="list-group-item-heading">@group.Name</h4>
                        <ul class="list-unstyled">
                            @foreach (var item in group.Items)
                            {
                                <li>
                                    <div class="checkbox">
                                        <label>
                                            <input type="checkbox" name="f" value="@item.VariantId" @(item.Selected ? "checked" : "")> @item.Value
                                            <span class="badge">@item.Quantity</span>
                                        </label>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </form>
    }
    else
    {
        <div class="search-result-facets-empty m-b-sm">
            <em class="text-muted">@Html.Localized("SEARCH_RESULTS_NO_FACETS")</em>
        </div>
    }
}

@helper QueryParamsAsHiddenFields()
{
    if (Request.QueryString != null)
    {
        foreach (var key in Request.QueryString.AllKeys.Where(x => !x.Equals("f", StringComparison.InvariantCultureIgnoreCase)))
        {
            foreach (var value in Request.QueryString.GetValues(key))
            {
                if (key != null && value != null)
                {
                    @:@Html.Hidden(key, value)
                }
            }
        }
    }
}