@using Microsoft.AspNet.Identity
@model Application.Modules.Products.Orders.MyOrdersViewModel

@{
    ViewBag.Title = Request.GetLocalizedString("MY_ORDERS_LINK");
    var viewPathFmt = "~/Views/Products/MyOrders/{0}.cshtml";
    var loginProfile = User.Identity.GetLoginProfile();
}

@section styles{
    @Styles.Render("~/Content/datatable")
}

<!-- CONTENTS -->
<div class="main-content bg-1 padding-top-30 padding-bottom-60">
    <div class="container">
        @Html.Partial("_ProfileInvisibleMessage", loginProfile)

        <div class="row">
            <div class="col-xs-12">
                @Html.Partial("_UserMenu", loginProfile)
            </div>
            <div class="col-xs-12">
                @Html.Localized("MY_ORDERS_LINK", "h3")
                @Html.Partial(string.Format(viewPathFmt, "_Orders"), Model.Orders)
            </div>
        </div>
    </div>
</div>
<!-- /CONTENTS -->

@section plugins {
    @Scripts.Render("~/bundles/datatable")
}

@section scripts {
    <script>
        $(document).ready(function () {
            var table = $('table').DataTable({
                "dom": '<<"pull-right"B><"pull-left"f>>rtip',
                "info": false,
                "oLanguage": {
                    "oPaginate": {
                        "sPrevious": "«",
                        "sNext": "»"
                    }
                }
            });
        });
    </script>
}