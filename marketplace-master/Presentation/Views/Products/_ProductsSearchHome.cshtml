@using Application.Modules.Products.Search
@using Presentation.Helpers

@model ProductsSearchHomeViewModel

@{
    var config = MaaSConfig.Current;
    var searchRangeOptions = config.Search.List.SearchRangeOptions;
    var isMobile = BrowserHelper.IsMobileBrowser();

    var columnCount = 0;
    if (config.Search.SearchFields.Query) { columnCount++; }
    if (config.Search.SearchFields.Category) { columnCount++; }
    if (config.Search.SearchFields.Location) { columnCount++; }

    if (config.Search.SearchFields.LocationRange)
    {
        columnCount++;

        Model.LocationRange = config.Search.List.SearchRange;
    }

    if (columnCount == 4) { columnCount = 2; }

    var columnSize = 12 / Math.Max(columnCount, 1);
}

@if (config.Search.Enabled)
{
    <form id="searchForm" action="@Url.ActionLocalized("Search", "Products", new {area = ""})" name="search_home container-fluid">
        <div class="row">
            @if (config.Search.SearchFields.Query)
            {
                <div class="col-xs-12 col-md-@columnSize">
                    <div class="form-group">
                        @Html.TextBoxFor(model => model.Product, new { @class = "form-control", placeholder = Request.GetLocalizedString("PRODUCT_FILTER_INPUT") })
                    </div>
                </div>
            }

            @if (config.Search.SearchFields.Category)
            {
                <div class="col-xs-12 col-md-@columnSize">
                    <div class="form-group">
                        @Html.Partial("~/Views/Products/_ProductCategoriesSelect.cshtml", Model)
                        @if (Request.QueryString["err"] == "1")
                        {
                            <small id="product-search-category-error" class="text-danger">@Request.GetLocalizedString("ECOMMERCE_HOME_CATEGORY_ID_ERROR")</small>
                        }
                    </div>
                </div>
            }

            @if (config.Search.SearchFields.Location)
            {
                <div class="col-xs-12 col-md-@columnSize">
                    @Html.Partial("_GoogleMapsAutocomplete")
                </div>
            }

            @if (config.Search.SearchFields.LocationRange)
            {
                <div class="col-xs-12 col-md-@columnSize">
                    <div class="form-group">
                        @Html.DropDownListFor(model => model.LocationRange,
                            new SelectList(searchRangeOptions, "Value", "Label", Model.LocationRange),
                            new { @class = isMobile ? "form-control" : "form-control js-select" })

                        @Html.ValidationMessageFor(model => model.LocationRange, "", new { @class = "text-danger" })
                    </div>
                </div>
            }
        </div>

        @if (config.Search.SearchFields.PeriodAvailability)
        {
            <div class="row">
                <div class="col-xs-6">
                    <div class="radio">
                        <label>
                            @Html.RadioButtonFor(model => model.SearchDaysOfWeek, SearchDaysOfWeek.OnlySatAndSun)
                            @Html.Localized("PRODUCT_SEARCH_FILTER_ONLY_SAT_AND_SUN")
                        </label>
                    </div>
                    <div class="radio">
                        <label>
                            @Html.RadioButtonFor(model => model.SearchDaysOfWeek, SearchDaysOfWeek.OnlyMonToFri)
                            @Html.Localized("PRODUCT_SEARCH_FILTER_ONLY_MON_TO_FRI")
                        </label>
                    </div>
                    <div class="radio">
                        <label>
                            @Html.RadioButtonFor(model => model.SearchDaysOfWeek, SearchDaysOfWeek.AllDaysOfWeek)
                            @Html.Localized("PRODUCT_SEARCH_FILTER_ONLY_ALL_DAYS_OF_WEEK")
                        </label>
                    </div>
                </div>

                <div class="col-xs-6">
                    <div class="checkbox">
                        <label>
                            @Html.CheckBoxFor(model => model.OnlyMorning)
                            @Html.Localized("PRODUCT_SEARCH_FILTER_ONLY_MORNING")
                        </label>
                    </div>
                    <div class="checkbox">
                        <label>
                            @Html.CheckBoxFor(model => model.OnlyAfternoon)
                            @Html.Localized("PRODUCT_SEARCH_FILTER_ONLY_AFTERNOON")
                        </label>
                    </div>
                    <div class="checkbox">
                        <label>
                            @Html.CheckBoxFor(model => model.OnlyNight)
                            @Html.Localized("PRODUCT_SEARCH_FILTER_ONLY_NIGHT")
                        </label>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    @Html.Hidden("StartDate", Model.StartDate?.ToString("yyyy-MM-dd"))
                    @Html.Hidden("EndDate", Model.EndDate?.ToString("yyyy-MM-dd"))

                    <div class="row">
                        <div class="col-xs-12 col-sm-6">
                            @Html.TextBox("StartDateInput", Model.StartDate?.DisplayDate("GMT Standard Time"), new { @class = "form-control", placeholder = Request.GetLocalizedString("PRODUCT_SEARCH_FILTER_START_DATE"), @readonly = "readonly" })
                            <div style="overflow: hidden" class="js-datepicker-start-container">
                                <div class="form-group">
                                    <center><div id="startDatePicker"></div></center>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6">
                            @Html.TextBox("EndDateInput", Model.EndDate?.DisplayDate("GMT Standard Time"), new { @class = "form-control", placeholder = Request.GetLocalizedString("PRODUCT_SEARCH_FILTER_END_DATE"), @readonly = "readonly" })
                            <div style="overflow: hidden" class="js-datepicker-end-container">
                                <div class="form-group">
                                    <center><div id="endDatePicker"></div></center>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row margin-top-10 margin-bottom-default text-center">
            <div class="col-xs-12">
                @Html.Localized("PRODUCT_FIND_BUTTON", "a", new { href = "javascript:document.getElementById('searchForm').submit()", @class = "home-hero-main-btn" })
            </div>
        </div>
    </form>
}