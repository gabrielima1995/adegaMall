@{
    var config = MaaSConfig.Current;
}

@if (config.HomeCallSellers.Enabled)
{
    <!-- CALL SELLERS -->
    <div class="call-sellers">
        <div class="container">
            <div class="row flex-valign">
                <div class="col-xs-12 col-sm-6 col-md-8">
                    <div class="container-fluid">
                        <div class="row text-center" style="margin-bottom: 30px">
                            @Html.Localized("CALL_SELLERS_TITLE", "h2", new { @class = "call-sellers-title", style = "margin-top: 0" })
                            <div class="col-xs-12 col-md-4">
                                <div class="box">@Html.Localized("HELP_QUESTION_1")</div>
                            </div>
                            <div class="col-xs-12 col-md-4">
                                <div class="box">@Html.Localized("HELP_QUESTION_2")</div>
                            </div>
                            <div class="col-xs-12 col-md-4">
                                <div class="box">@Html.Localized("HELP_QUESTION_3")</div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xs-12 text-center">
                                @Html.Localized("CALL_SELLERS_LINK", "a", new { @class = "call-sellers-action-btn", href = Url.ActionLocalized("Seller", "Register") })
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xs-12 col-sm-6 col-md-4">
                    <img src="@config.Layout.Images.HomeCallSellers" alt="">
                </div>
            </div>
        </div>
    </div>
    <!-- /CALL SELLERS -->
}
