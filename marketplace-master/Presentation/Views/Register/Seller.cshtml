@model Application.Sellers.SellerRegisterViewModel

@{
    var config = MaaSConfig.Current;
    ViewBag.Title = Request.GetLocalizedString("REGISTER_LINK");
}

<div class="main-content bg-image-2 padding-top-120 padding-bottom-120">
    <div class="container">
        <div class="row">
            @Html.Partial("_SellerHelpQuestions")

            <div class="visible-xs margin-top-30 col-xs-12"></div>

            <div class="col-xs-12 col-sm-6 col-md-5">
                <div class="box-content text-center equal-height">

                    @if (!config.Facebook.DisableLoginForSeller)
                    {
                        using (Html.BeginForm("ExternalLogin", "Account", new { lang = Request.GetCurrentLang(), returnUrl = ViewBag.ReturnUrl, person = PersonLogin.Seller }))
                        {
                            @Html.AntiForgeryToken()

                            @Html.Localized("REGISTER_FACEBOOK_BUTTON", "button", new { type = "submit", @class = "facebook-btn", id = "Facebook", name = "provider", value = "Facebook" })
                        }

                        @Html.Localized("OR_TEXT")<br />
                    }
                    
                    @Html.Localized("JOIN_FORM_TEXT")

                    @Html.Partial("_SellerForm")

                </div>
            </div>
        </div>
    </div>
</div>
