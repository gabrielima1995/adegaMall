@model Application.Sellers.SellerProfileViewModel

@{
    ViewBag.Title = Request.GetLocalizedString("COMPLETE_REGISTER_TITLE");
    ViewBag.AllFields = false;
    ViewBag.PostController = "Register";
    ViewBag.PostAction = "CompleteSeller";
}

<div class="main-content bg-image-2 padding-top-120 padding-bottom-120">
    <div class="container">
        <div class="row">
            <div class="col-md-offset-2 col-md-8">
                <div class="box-content">
                    @Html.Partial("_SellerProfileForm", Model)
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/scripts/maps-addresshelper")
    @Html.Partial("_GoogleMapsScript")
    @Html.Partial("_CitiesScript")

    <script>SellerAddressAutocomplete.init()</script>
    <script>
        $(document).ready(function () {
            $("#btnConfirmSkip.btn").click(function () {
                $("#confirmSkip").modal("show");
            });
        });
        $(".wpp-phone-input").mask("(00) 00000-0000");
    </script>
}