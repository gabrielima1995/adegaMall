@model Application.Sellers.SellerRegisterViewModel

@{
    var config = MaaSConfig.Current;
    ViewBag.Title = Request.GetLocalizedString("REGISTER_LINK");
}

<div class="main-content bg-image-2 padding-top-120 padding-bottom-120">
    <div class="container">
        <div class="row">
            <div class="visible-xs margin-top-30 col-xs-12"></div>

            <div class="col-xs-0 col-sm-3 col-md-4"></div>
            <div class="col-xs-12 col-sm-6 col-md-4">
                <div class="box-content text-center equal-height">
                    <h4>Aviso Importante</h4>
                    <p>Obrigado por se cadastrar! Seu perfil precisa ser ativado pela nossa moderação antes de seu cadastro ser concluído.</p>
                    <p>Você será notificado por e-mail assim que seu perfil estiver pronto para uso.</p>
                </div>
            </div>
        </div>
    </div>
</div>
