@model Presentation.Models.BuyerProfileVM

@{
    ViewBag.Title = Request.GetLocalizedString("COMPLETE_REGISTER_TITLE");
    ViewBag.AllFields = false;
    ViewBag.PostController = "Register";
    ViewBag.PostAction = "CompleteBuyer";
}

<div class="main-content bg-image-2 padding-top-120 padding-bottom-120">
    <div class="container">
        <div class="row">
            <div class="col-xs-12 col-sm-offset-1 col-sm-10 col-md-offset-3 col-md-6">
                <div class="box-content">
                    @Html.Partial("_BuyerProfileForm", Model)
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    @Html.Partial("_CitiesScript")
}