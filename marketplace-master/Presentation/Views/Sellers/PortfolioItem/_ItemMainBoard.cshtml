@using System.Globalization
@using Application.Sellers
@model Presentation.Models.PortfolioViewModels.PortfolioItemPageVM

@{
    var viewPathFmt = "~/Views/Sellers/PortfolioItem/{0}.cshtml";
    var config = MaaSConfig.Current;
    var showQuoteRequest = config.Quote.PortfolioItemQuote.Enabled;
}

<div class="row m-b-sm">
    <div class="col-xs-12">
        <div class="panel panel-default">
            <div class="panel-body">
                <div class="row">
                    <div class="col-xs-12 col-md-6">
                        @if (Model.IsVideo)
                        {
                            <div class="video-wrapper">
                                @Html.Raw(Model.VideoUrl.CreateEmbed())
                            </div>
                        }
                        else
                        {
                            @Html.Partial(string.Format(viewPathFmt, "_ItemImagesCarousel"), Model)
                        }
                    </div>
                    <div class="col-xs-12 col-md-6">
                        <h1 class="product-title">@Model.Title</h1>

                        @if (Model.HasPrice)
                        {
                            var currency = config.DefaultCurrency;
                            var culture = CultureInfo.CurrentUICulture;
                            var formatted = Model.Price.Value.ToString("N2", culture);
                            var parts = formatted.Split(
                                new[] { culture.NumberFormat.NumberDecimalSeparator },
                                StringSplitOptions.None);

                            var integerPart = parts[0];
                            var centsPart = parts[1];

                            <div class="product-price">
                                <div class="product-price-amount">

                                    <div>
                                        @currency
                                        @integerPart<span class="product-price-cents">@centsPart</span>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="product-sold-by">
                            <img src="@Model.Seller.GetAvatarUrl(50, 50)" alt="@Model.Seller.PublicProfileName" class="img-circle" width="50" height="50" />
                            <small>@Request.GetLocalizedString("CART_ITEM_SOLD_AND_DELIVERED_BY")</small>
                            <br />
                            <span>@Model.Seller.PublicProfileName (@Html.Localized("PROFILE_URL_LABEL", "a", new { href = Url.ActionLocalized("PublicProfile", "Sellers", new { nickname = Model.Seller.FriendlyUrl }) }))</span>
                            @if (config.Seller.UserRatings.Enabled)
                            {
                                <p>
                                    @Html.Partial("_RatingStars", Model.SellerRatingAverage) -
                                    <a class="text-primary" href="@Url.ActionLocalized("Overview","UserRating", new { sellerId = Model.SellerId })">@Model.SellerRatingsCount @Request.GetLocalizedString("RATINGS_COUNT")</a>
                                </p>
                            }
                        </div>

                        @if (showQuoteRequest)
                        {
                            <div class="margin-top-10 margin-bottom-10">
                                <div class="row">
                                    <div class="col-xs-12">
                                        @Html.Localized("PORTFOLIO_ITEM_QUOTE_REQUEST_BUTTON", "a", new { href = Url.ActionLocalized("Request", "Quotes", new { sellerId = Model.SellerId, portfolioItemId = Model.Id, area = "" }), @class = "btn btn-primary btn-lg box-shadow" })
                                    </div>
                                </div>
                            </div>
                        }

                        @if (MaaSConfig.Current.SocialMedia.EnableShareButtons)
                        {
                            <div class="row">
                                <div class="col-xs-12 col-md-6">
                                    @Html.Localized("SOCIAL_SHARE_PRODUCT_LABEL", "strong")
                                    <div class="sharethis-inline-share-buttons"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>