@using Application.Modules.Products
@model Application.Modules.Portfolio.PortfolioItemVM

@{
    var carouselId = "product-images-carousel-" + Model.Id;
    var total = Model.Images.Count;
    var mode = MaaSConfig.Current.Portfolio.ThumbnailCrop.Enabled ? "crop" : "pad";
}

<div id="@carouselId" class="carousel slide" data-ride="carousel" data-interval="false">
    @if (total > 1)
    {
        <!-- Indicators -->
        <ol class="carousel-indicators">
            @for (int i = 0; i < total; i++)
            {
                <li data-target="#@carouselId" data-slide-to="@i" class="@(i == 0 ? "active" : "")"></li>
            }
        </ol>
    }
    <!-- Wrapper for slides -->
    <div class="carousel-inner" role="listbox">
        @for (int i = 0; i < total; i++)
        {
            <div class="item @(i == 0 ? "active" : "")">
                <img class="img-responsive center-block border-radius" src="@ProductsHelper.GetImageUrl(Model.Images[i].Url, ProductImageSize.MD, mode)" alt="@Model.Title">
            </div>
        }

        @if (total == 0 && Model.CoverImageUrl != null)
        {
            <div class="item active">
                <img class="img-responsive center-block border-radius" src="@ProductsHelper.GetImageUrl(Model.CoverImageUrl, ProductImageSize.MD, mode)" alt="@Model.Title" width="600" height="600">
            </div>
        }
    </div>

    @if (total > 1)
    {
        <a class="left carousel-control" href="#@carouselId" role="button" data-slide="prev">
            <span class="glyphicon glyphicon-chevron-left" aria-hidden="true"></span>
            <span class="sr-only">Previous</span>
        </a>
        <a class="right carousel-control" href="#@carouselId" role="button" data-slide="next">
            <span class="glyphicon glyphicon-chevron-right" aria-hidden="true"></span>
            <span class="sr-only">Next</span>
        </a>
    }
</div>
