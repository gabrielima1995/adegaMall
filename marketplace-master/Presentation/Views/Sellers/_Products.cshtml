@using Application.Modules.Products
@using Domain.Entities.StoreModule
@using Microsoft.AspNet.Identity
@using V2.Application.Modules.Search.Products

@model PublicProfileVM

@{
    var products = Model.Products ?? new List<Product>(0);
    products = products.Where(x => !x.IsDisabled.GetValueOrDefault()).ToList();
    var config = MaaSConfig.Current;
    var isAuthenticated = Request.IsAuthenticated;
    var showProductWishButton = config.Product.Wishlist.Enabled && (!isAuthenticated || User.Identity.GetLoginProfile().IsBuyer());
}

<div class="container m-b-md">
    <div class="row">
        <div class="col-md-12">
            <h4 class="margin-bottom-15">@Html.Localized("PRODUCTS_FROM_SELLER")</h4>
        </div>

        @if (products.Count > 0)
        {
            foreach (var product in products)
            {
                var price = product.ProductPriceMapped;
                var productUrl = Url.ActionLocalized("PublicPage", "Products", new { id = product.FriendlyUrl });
                var paisBadge = product.GetPaisBadge();

                <div class="col-xs-12 col-sm-4 col-md-3">
                    <div class="card equal-height">
                        @if (price.DisplayShortPrice.HasAnyPrice)
                        {
                            if (price.DisplayShortPrice.Discount.HasDiscount)
                            {
                                <div class="card-discount-badge">
                                    <span class="label label-success">@price.DisplayShortPrice.Discount.Formatted</span>
                                </div>
                            }
                        }

                        @if (showProductWishButton)
                        {
                            @Html.Partial("_ProductWishButtonCard", product)
                        }

                        <a href="@productUrl" title="@product.Title" class="card-product-img-link">
                            <img src="~/assets/images/product-img-placeholder.jpg" data-src="@product.GetCoverImageUrl(ProductImageSize.SM)" alt="@product.Title" class="js-load-img" />
                        </a>

                        @if (!string.IsNullOrEmpty(paisBadge))
                        {
                            <div class="card-country-badge">
                                <img src="/assets/images/paises/@(paisBadge).png?w=25&h=25" />
                            </div>
                        }

                        <h5 class="card-product-title">@product.Title</h5>

                        <small class="text-muted" style="display: block">
                            @Model.Seller.PublicProfileName
                        </small>

                        @if (config.Product.Price.Enabled && price.DisplayShortPrice.HasAnyPrice)
                        {
                            if (price.DisplayShortPrice.Discount.HasDiscount)
                            {
                                <p class="card-discount-price">
                                    <small>
                                        de <span class="card-discount-price-amount">@price.DisplayShortPrice.Discount.Original.FullPriceText</span> por
                                    </small>
                                </p>
                            }

                            else if (price.DisplayShortPrice.CanIncrease)
                            {
                                <p class="card-price-starting-from">
                                    <small>
                                        @Html.Localized("PRODUCT_PRICE_STARTING_FROM", "span", new { @class = "text-muted" })
                                    </small>
                                </p>
                            }

                            <div class="card-product-price">
                                @if (price.HasBasePrice)
                                {
                                    <div>
                                        @price.DisplayShortPrice.FullPriceText
                                        @if (price.DisplayShortPrice.HasTextComplementLabel)
                                        {
                                            <small class="text-muted text-lowercase">/ @string.Format(Request.GetLocalizedString(price.DisplayShortPrice.TextComplementLabel), price.DisplayShortPrice.TextComplementParam)</small>
                                        }
                                    </div>
                                }

                                @if (price.DisplayShortPrice.HasAdditionalPrice)
                                {
                                    <div class="card-product-price-additional">
                                        <span class="card-product-price-additional-amount">@price.DisplayShortPrice.AdditionalPriceText</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="card-product-price">&nbsp;</p>
                        }

                        <a href="@productUrl" class="btn btn-default btn-round card-btn">
                            <i class="glyphicon glyphicon-chevron-right"></i>
                            @Request.GetLocalizedString("PRODUCT_PUBLIC_PAGE_BUTTON")
                        </a>
                    </div>
                </div>
            }

            if (Model.ShowLinkForMoreProducts)
            {
                <div class="col-xs-12">
                    <a href="@Model.LinkForMoreProducts" class="btn btn-default btn-lg btn-block">
                        <i class="fa fa-th-large"></i>
                        @Request.GetLocalizedString("SELLER_PRODUCTS_SEE_ALL")
                    </a>
                </div>
            }
        }
        else
        {
            <div class="col-md-12">
                <p>@Html.Localized("PRODUCTS_FROM_SELLER_EMPTY")</p>
            </div>
        }
    </div>
</div>