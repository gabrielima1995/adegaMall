@model IEnumerable<Domain.Entities.AdminPerson>

@{
    ViewBag.Title = "Admins";
}

<section class="content-header">
    <h1>
        <i class="fa fa-user" aria-hidden="true"></i>
        @ViewBag.Title
    </h1>
</section>

<section class="content container-fluid">
    <div class="row">
        <div class="col-sm-6">
            @Html.Partial("_CreateForm", new AdminCreateViewModel())
        </div>
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                </tr>
            }
        </tbody>
    </table>
</section>
