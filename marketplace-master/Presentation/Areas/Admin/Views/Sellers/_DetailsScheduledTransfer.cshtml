@using Presentation.Helpers
@using Domain.DTO
@using Presentation.Helpers
@model List<SellerScheduledTransferViewModel>

@{
    var config = MaaSConfig.Current;
}

@if (config.Payment.ActiveGateway.Equals("pagarme") && config.Payment.Common.EnableTransactionWarranty)
{
    <div class="tab-pane" id="scheduledTransfer">
        @if (Model.Count != 0)
        {
            <div class="table-responsive">
                <table id="scheduledTransferList" class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>Código do Pedido</th>
                            <th>Comprador</th>
                            <th>Valor</th>
                            <th data-sort="desc">Data do início</th>
                            <th data-sort="desc">Data transferência</th>
                            <th>Transferência autorizada</th>
                            <th>Transferido</th>
                            <th>Cancelado</th>
                            <th>Parcelas</th>
                            <th>Parcela Atual</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td data-order="@Dt.Order(item.OrderId)">
                                    <a href="@Url.ActionLocalized("Details", "Orders", new { id = item.OrderId })">@item.OrderId.ToString().Substring(0, 8)</a>
                                </td>
                                <td data-order="@Dt.Order(item.BuyerFullName)">
                                    <a href="@Url.ActionLocalized("Details", "Buyers", new { id = item.BuyerId })">@item.BuyerFullName</a>
                                </td>
                                <td data-order="@Dt.Order(item.TransferAmount)">@item.TransferAmount.FromCents()</td>
                                <td data-order="@Dt.Order(item.CreatedAt)">@Html.DisplayFor(model => item.CreatedAt)</td>
                                <td data-order="@Dt.Order(item.DueDate)">@Html.DisplayFor(model => item.DueDate)</td>
                                <td data-order="@Dt.Order(item.TransferAuthorized)">@(item.TransferAuthorized ? "SIM" : "NÃO")</td>
                                <td data-order="@Dt.Order(item.Transferred)">@(item.Transferred ? "SIM" : "NÃO")</td>
                                <td data-order="@Dt.Order(item.Canceled)">@(item.Canceled ? "SIM" : "NÃO")</td>
                                <td data-order="@Dt.Order(item.Installments)">@Html.DisplayFor(model => item.Installments)</td>
                                <td data-order="@Dt.Order(item.CurrentInstallment)">@Html.DisplayFor(model => item.CurrentInstallment)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p>Sua plataforma tem o Pagamento em Garantia habilitado. Quando este vendedor fizer uma venda, você verá aqui a previsão de liberação dos pagamentos de acordo com a data de conclusão dos serviços prestados ou entrega dos produtos vendidos, conforme o caso.</p>
        }
    </div>
}
