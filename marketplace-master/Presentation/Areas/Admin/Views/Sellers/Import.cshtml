@model Presentation.Areas.Admin.Views.Sellers.ImportModel

@{
    ViewBag.Title = Request.GetLocalizedString("IMPORT_SELLERS");
}

<section class="content-header">
    <h1>
        <i class="fas fa-file-import" aria-hidden="true"></i>
        @ViewBag.Title
    </h1>

    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Dashboard")"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li><a href="@Url.Action("Index", "Sellers")">@Html.Localized("SELLERS_LANG_UBIQUITOUS")</a></li>
        <li class="active">@Request.GetLocalizedString("IMPORT_SELLERS")</li>
    </ol>
</section>

<section class="content container-fluid">
    <div class="box">
        <div class="box-body">
            @Html.Localized("SELLERS_IMPORT_TEXT", "p")
            <ul>
                <li>
                    @Html.Localized("BATCH_IMPORT_WELCOME_EMAIL_NOTICE")
                    @Html.Localized("SETTINGS", "a", new { href = Url.ActionLocalized("Edit", "MessageTemplates", new { Area = "Admin", Key = "WelcomeMessage" }) })
                </li>
                <li>@Html.Localized("BATCH_IMPORT_PASSWORD_RESET_NOTICE")</li>
            </ul>
            <div class="row">
                <div class="col-md-3">
                    <div class="form">
                        <div class="form-group">
                            @Html.DropDownList("SourceTypeSelect", Model.SourceTypes, Request.GetLocalizedString("SELLERS_IMPORT_SELECT_FORMAT"), new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>

            <div id="steps" style="display: none">
                <hr />
                <div class="row">
                    <div class="col-md-6">
                        <h4><i class="fa fa-download"></i> @Request.GetLocalizedString("SELLERS_IMPORT_STEP_1")</h4>
                        @Html.Localized("SELLERS_IMPORT_GENERATE_TEMPLATE", "h5")
                        @Html.Localized("SELLERS_IMPORT_GENERATE_TEMPLATE_TEXT", "p")

                        <a href="javascript:void(0)" id="btnDownloadTemplate" target="_blank" class="btn btn-default" data-baseurl="@Url.ActionLocalized("DownloadImportTemplate", "Sellers")">
                            @Request.GetLocalizedString("SELLERS_IMPORT_GENERATE_TEMPLATE_BUTTON")
                        </a>
                    </div>

                    <div class="col-md-6">
                        <h4><i class="fa fa-cloud-upload"></i> @Request.GetLocalizedString("SELLERS_IMPORT_STEP_2")</h4>
                        @Html.Localized("SELLERS_IMPORT_UPLOAD_SOURCE", "h5")
                        @Html.Localized("SELLERS_IMPORT_UPLOAD_SOURCE_TEXT", "p")
                        @Html.Partial("_UploadImportFile")
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
{
    <script>SellersImport.init()</script>
}
