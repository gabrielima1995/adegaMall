@model double

<span title="@Model.ToString("0.00")">
    @for (int i = 0; i < 5; i++)
    {
        if (Model - i >= 0.9)
        {
            <i class="fa fa-star rating-star"></i>
        }
        else if (Model - i >= 0.5)
        {
            <i class="fa fa-star-half-o rating-star"></i>
        }
        else
        {
            <i class="fa fa-star-o rating-star"></i>
        }
    }
</span>