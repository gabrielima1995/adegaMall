@using Presentation.Helpers;

<script>
    window.intercomSettings = {
        app_id: '@IntercomSettings.AppId',
        name: '@Html.Raw(IntercomSettings.UserName)',
        email: '@(IntercomSettings.UserEmail)',
        user_hash: '@IntercomSettings.UserHash',
        marketplace_name: '@Html.Raw(IntercomSettings.MarketplaceName)',
        marketplace_url: '@IntercomSettings.MarketplaceUrl',
        @if(!string.IsNullOrEmpty(MaaSConfig.Current.Intercom.CompanyId)
         && !string.IsNullOrEmpty(MaaSConfig.Current.Intercom.CompanyName))
        {
            @:company:
            @: {
            @:    id: "@MaaSConfig.Current.Intercom.CompanyId",
            @:    name: "@MaaSConfig.Current.Intercom.CompanyName",
            @: }
        }
    };
</script>
