@using Domain.DTO
@model BannerCreateEditVM

@{
    ViewBag.Title = Request.GetLocalizedString("CUSTOMIZE_DOCS_TITLE");
}

<section class="content-header">
    <h1>
        <i class="fa fa-paint-brush" aria-hidden="true"></i>
        @ViewBag.Title
    </h1>
</section>

<section class="content container-fluid">
    <div class="row">
        <div class="col-xs-12 col-md-6">
            <div class="box">
                @*<div class="box-header with-border">
                    <h3 class="box-title">@Request.GetLocalizedString("CUSTOMIZE_SELLER_BENEFITS_LABEL")</h3>
                </div>*@
                <div class="box-body">
                    @*<p><small class="text-muted">@Request.GetLocalizedString("CUSTOMIZE_SELLER_BENEFITS_HELP")</small></p>*@

                    <p>
                        <small class="text-muted">
                            <strong>@Request.GetLocalizedString("CUSTOMIZE_HINT"):</strong>
                            @Request.GetLocalizedString("CUSTOMIZE_DOCS_HINT")
                            @*<a href="/assets/images/template-icon-300x300.png" target="_blank">Template</a>*@
                        </small>
                    </p>

                    <hr class="thin" />

                    @Html.Partial("_File", new CustomizeFileInfoVM
                    {
                        FileType = CloudFileType.PlatformDocument,
                        Option = CustomizeOption.UseTerms,
                        RedirectUrl = Url.ActionLocalized("Docs", "Customize", new { area = "Admin" }),
                        CurrentUrl = MaaSConfig.Current.Enterprise.TermsOfUseUrl,
                        Label = Request.GetLocalizedString("CUSTOMIZE_USE_TERMS_LABEL"),
                        UiNoBox = true
                    })

                    <hr class="thin" />

                    @Html.Partial("_File", new CustomizeFileInfoVM
                    {
                        FileType = CloudFileType.PlatformDocument,
                        Option = CustomizeOption.PrivacyPolicy,
                        RedirectUrl = Url.ActionLocalized("Docs", "Customize", new { area = "Admin" }),
                        CurrentUrl = MaaSConfig.Current.Enterprise.PrivacyPolicyUrl,
                        Label = Request.GetLocalizedString("CUSTOMIZE_PRIVACY_POLICY_LABEL"),
                        UiNoBox = true
                    })
                </div>
            </div>
        </div>
    </div>
</section>

@section scripts
{
    <script>Customize.init()</script>
}