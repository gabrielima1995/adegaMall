@using Presentation.Helpers
@model CreditsPackViewModel

@{
    var config = MaaSConfig.Current;
}


<div class="form-group">
    @Html.Label("Nome do pacote")
    @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control" })
    @Html.ValidationMessageFor(Model => Model.Name, "", new { @class = "text-danger" })
</div>
<div class="form-group">
    @Html.Label("Nome do pacote em inglês (opcional)")
    @Html.TextBoxFor(Model => Model.Name_EN, new { @class = "form-control" })
    @Html.ValidationMessageFor(Model => Model.Name_EN, "", new { @class = "text-danger" })
</div>
<div class="form-group">
    @Html.Label("Descrição (opcional)")
    @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control", style = "resize:vertical" })
    @Html.ValidationMessageFor(Model => Model.Description, "", new { @class = "text-danger" })
</div>
<div class="form-group">
    @Html.Label("Descrição em inglês (opcional)")
    @Html.TextAreaFor(Model => Model.Description_EN, new { @class = "form-control", style = "resize:vertical" })
    @Html.ValidationMessageFor(Model => Model.Description_EN, "", new { @class = "text-danger" })
</div>
<div class="row">
    <div class="col-xs-6 form-group">
        @Html.Label("Quantidade de créditos")
        @Html.TextBoxFor(Model => Model.CreditsAmount, new { @class = "form-control", type = "number", min = "1" })
        @Html.ValidationMessageFor(Model => Model.CreditsAmount, "", new { @class = "text-danger" })
    </div>
    <div class="col-xs-6 form-group">
        @Html.Label("Preço")
        @Html.TextBoxFor(Model => Model.Price, new { @class = "form-control js-money", min = "1" })
        @Html.ValidationMessageFor(Model => Model.Price, "", new { @class = "text-danger" })
    </div>
</div>
@if (config.Quote.LeadSales.CreditsExpire)
{
    <div class="form-group">
        @Html.Label("Validade (dias)")
        @Html.TextBoxFor(Model => Model.ValidityDays, new { @class = "form-control", type = "number", min = "1" })
        @Html.ValidationMessageFor(Model => Model.ValidityDays, "", new { @class = "text-danger" })
    </div>
}
