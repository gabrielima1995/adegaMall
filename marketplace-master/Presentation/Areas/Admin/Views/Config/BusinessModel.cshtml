@model int
@{
    ViewBag.Title = "Configuração de Modelo de Negócios";
}

<section class="content-header"></section>

<section class="content container">
    <div class="config-step" id="part-1">
        <div class="text-center">
            <br />
            <h3>Etapa 1</h3>
            <h1>Configure seu modelo de negócios</h1>
            <br />
            <h3>Sua plataforma irá lidar com produtos ou com prestação de serviços?</h3>
            <br />
        </div>
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-4 col-md-offset-2">
                <div class="box box-primary">
                    <div class="box-header text-center">
                        <h3 class="box-title"><strong>Trabalho com produtos</strong> <i class="fa fa-shopping-bag"></i></h3>
                    </div>
                    <div class="box-body text-center">
                        <p>Minha plataforma vai lidar com ítens físicos que serão entregues diretamente aos compradores.</p>
                        <button class="btn btn-primary btn-next-part" data-nextpart="part-2-products"><i class="fa fa-check"></i> Selecionar</button>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4">
                <div class="box box-primary">
                    <div class="box-header text-center">
                        <h3 class="box-title"><strong>Trabalho com serviços</strong> <i class="fa fa-handshake-o"></i></h3>
                    </div>
                    <div class="box-body text-center">
                        <p>Minha plataforma irá trabalhar com prestação de serviços, que deverá ser combinada entre vendedores e compradores.</p>
                        <button class="btn btn-primary btn-next-part" data-nextpart="part-2-services"><i class="fa fa-check"></i> Selecionar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="config-step" id="part-2-products" style="display:none">
        <div class="text-center">
            <br />
            <h3>Etapa 2</h3>
            <h1>Configure sua marketplace de produtos</h1>
            <br />
            <h3>Você irá operar com venda ou locação de produtos?</h3>
            <br />
        </div>
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-4 col-md-offset-2">
                <div class="box box-primary">
                    <div class="box-header text-center">
                        <h3 class="box-title"><strong>Venda de Produtos</strong> <i class="fa fa-dollar"></i></h3>
                    </div>
                    <div class="box-body text-center">
                        <p>Produtos serão vendidos de forma permanente, o pedido é finalizado quando o comprador recebe o produto.</p>
                        <button class="btn btn-primary btn-choose-model" data-model-id="1"><i class="fa fa-check"></i> Selecionar</button>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4">
                <div class="box box-primary">
                    <div class="box-header text-center">
                        <h3 class="box-title"><strong>Locação de produtos</strong> <i class="fa fa-calendar-check-o"></i></h3>
                    </div>
                    <div class="box-body text-center">
                        <p>Produtos serão alugados por período, e o preço pode variar de acordo com a duração. Comprador deverá devolver o produto ao final do prazo contratado.</p>
                        <button class="btn btn-primary btn-choose-model" data-model-id="2"><i class="fa fa-check"></i> Selecionar</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-center">
            <button class="btn btn-primary btn-outline btn-next-part" data-nextpart="part-1"><i class="fa fa-reply"></i> Voltar</button>
        </div>
    </div>
    <div class="config-step" id="part-2-services" style="display:none">
        <div class="text-center">
            <br />
            <h3>Etapa 2</h3>
            <h1>Configure sua marketplace de serviços</h1>
            <br />
            <h3>Você irá operar por agendamento ou por orçamento?</h3>
            <br />
        </div>
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-4 col-md-offset-2">
                <div class="box box-primary">
                    <div class="box-header text-center">
                        <h3 class="box-title"><strong>Agendamento de Serviços</strong> <i class="fa fa-calendar-check-o"></i></h3>
                    </div>
                    <div class="box-body text-center">
                        <p>Terei um portfólio de serviços a preços pré-determinados, que poderão ser adquiridos e agendados instantâneamente pelo comprador mediante disponibilidade de horário na agenda.</p>
                        <button class="btn btn-primary btn-choose-model" data-model-id="3"><i class="fa fa-check"></i> Selecionar</button>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4">
                <div class="box box-primary">
                    <div class="box-header text-center">
                        <h3 class="box-title"><strong>Pedidos de Orçamento</strong> <i class="fa fa-calendar-check-o"></i></h3>
                    </div>
                    <div class="box-body text-center">
                        <p>Compradores buscarão pelo perfil dos vendedores, e entrarão em contato diretamente para negociar e confirmar os detalhes do serviço antes de fechar o negócio.</p>
                        <button class="btn btn-primary btn-next-part" data-nextpart="part-3-quotes"><i class="fa fa-check"></i> Selecionar</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-center">
            <button class="btn btn-primary btn-outline btn-next-part" data-nextpart="part-1"><i class="fa fa-reply"></i> Voltar</button>
        </div>
    </div>
    <div class="config-step" id="part-3-quotes" style="display:none">
        <div class="text-center">
            <br />
            <h3>Etapa 3</h3>
            <h1>Configure sua marketplace de orçamento de serviços</h1>
            <br />
            <h3>Escolha uma base de modelo de negócios</h3>
            <br />
        </div>
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-4">
                <div class="box box-primary">
                    <div class="box-header text-center">
                        <h3 class="box-title"><strong>Apenas negociação</strong> <i class="fa fa-handshake-o"></i></h3>
                    </div>
                    <div class="box-body text-center">
                        <p>
                            Farei a conexão entre vendedores e compradores, que negociarão os detalhes de serviço pela plataforma, mas o pagamento será realizado por meios externos.
                            Vendedores precisarão ter um plano de assinatura para serem receberem orçamentos.
                        </p>
                        <button class="btn btn-primary btn-choose-model" data-model-id="4"><i class="fa fa-check"></i> Selecionar</button>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4">
                <div class="box box-primary">
                    <div class="box-header text-center">
                        <h3 class="box-title"><strong>Pagamento pela plataforma</strong> <i class="fa fa-credit-card"></i></h3>
                    </div>
                    <div class="box-body text-center">
                        <p>
                            Para fechar um negócio por um orçamento, vendedores poderão formalizar propostas e gerar cobranças para que o comprador pague pelo serviço diretamente pela plataforma.
                            Receberei uma comissão configurável a cada pagamento efetuado.
                        </p>
                        <button class="btn btn-primary btn-choose-model" data-model-id="5"><i class="fa fa-check"></i> Selecionar</button>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4">
                <div class="box box-primary">
                    <div class="box-header text-center">
                        <h3 class="box-title"><strong>Venda de Leads</strong> <i class="fa fa-address-card"></i></h3>
                    </div>
                    <div class="box-body text-center">
                        <p>
                            Vendedores receberão pedidos de orçamento pela plataforma, mas deverão gastar créditos para poderem visualizar os detalhes completos do orçamento.
                            Créditos serão adquiridos comprando pacotes avulsos ou assinaturas recorrentes com a marketplace.
                        </p>
                        <button class="btn btn-primary btn-choose-model" data-model-id="6"><i class="fa fa-check"></i> Selecionar</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-center">
            <button class="btn btn-primary btn-outline btn-next-part" data-nextpart="part-2-services"><i class="fa fa-reply"></i> Voltar</button>
        </div>
    </div>
    <div class="config-step" id="part-4-confirm" style="display:none">
        <div class="text-center">
            <br />
            <h3></h3>
            <h1>Revise e confirme suas escolhas</h1>
            <br />
        </div>
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-sm-offset-3 col-md-4 col-md-offset-4">
                <div class="box box-primary">
                    <div class="box-header text-center">
                        <h3 class="box-title"><strong>Configurar modelo de negócios</strong></h3>
                    </div>
                    <div class="box-body">
                        <div class="model-list model-list-1" style="display:none">
                            <ul>
                                <li>Marketplace de Produtos</li>
                                <li>Venda de Produtos</li>
                                <li>Monetização por Comissão</li>
                            </ul>
                        </div>
                        <div class="model-list model-list-2" style="display:none">
                            <ul>
                                <li>Marketplace de Produtos</li>
                                <li>Locação de Produtos</li>
                                <li>Monetização por Comissão</li>
                            </ul>
                        </div>
                        <div class="model-list model-list-3" style="display:none">
                            <ul>
                                <li>Marketplace de Serviços</li>
                                <li>Agendamento de Serviços</li>
                                <li>Monetização por Comissão</li>
                            </ul>
                        </div>
                        <div class="model-list model-list-4" style="display:none">
                            <ul>
                                <li>Marketplace de Serviços</li>
                                <li>Pedidos de Orçamento</li>
                                <li>Apenas Negociação</li>
                                <li>Monetização por assinatura</li>
                            </ul>
                        </div>
                        <div class="model-list model-list-5" style="display:none">
                            <ul>
                                <li>Marketplace de Serviços</li>
                                <li>Pedidos de Orçamento</li>
                                <li>Pagamento pela plataforma</li>
                                <li>Monetização por Comissão</li>
                            </ul>
                        </div>
                        <div class="model-list model-list-6" style="display:none">
                            <ul>
                                <li>Marketplace de Serviços</li>
                                <li>Pedidos de Orçamento</li>
                                <li>Venda de Leads</li>
                                <li>Monetização por venda de créditos/assinaturas</li>
                            </ul>
                        </div>
                        <div class="text-center">
                            <br />
                            @using (Html.BeginForm("ConfigureBusinessModel", "Config", FormMethod.Post))
                            {
                                //Html.Hidden("model_id", -1, new { id = "model_id" });
                                //Html.HiddenFor(Model, new { id = "model_id" });
                                <div class="form-group">
                                    <small class="text-danger">Algumas configurações existentes serão sobrescritas</small>
                                    <br />
                                    <label><input type="checkbox" required /> Estou ciente e quero prosseguir</label>
                                </div>
                                <input type="hidden" name="model_id" id="model_id" value="-1"/>
                                <button type="submit" class="btn btn-success btn-sm"><i class="fa fa-cog"></i> Aplicar Configurações</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-center">
            <button class="btn btn-primary btn-outline btn-next-part" data-nextpart="part-1"><i class="fa fa-reply"></i> Voltar</button>
        </div>
    </div>
</section>

@section scripts
{
    <script>
        $('.btn-next-part').on('click', function (e) {
            let nextPart = '#' + $(this).attr('data-nextpart');
            $(this).parents('.config-step').fadeOut(400, complete = function () {
                $(nextPart).fadeIn(400);
            });
        });

        $('.btn-choose-model').on('click', function (e) {
            let nextPart = '#part-4-confirm';
            let modelId = $(this).attr('data-model-id');

            $('.model-list').hide(0);

            $(this).parents('.config-step').fadeOut(400, complete = function () {
                $('#model_id').val(modelId);
                $('.model-list-' + modelId).show(0);
                $(nextPart).fadeIn(400);
            });
        });
    </script>
}