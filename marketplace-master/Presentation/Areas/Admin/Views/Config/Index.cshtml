@model Presentation.Areas.Admin.Models.ConfigViewModel

@{
    ViewBag.Title = "Configuração";
}

@section styles
{
    <link href="~/Areas/Admin/plugins/jsoneditor/jsoneditor.css" rel="stylesheet" />
    <style type="text/css">#jsoneditor { width: 100%; height: 600px }</style>
}

<section class="content-header">
    <h1>
        <i class="fa fa-sliders" aria-hidden="true"></i>
        @ViewBag.Title
    </h1>
</section>

<section class="content container-fluid">

    @if (Request.QueryString["ok"] != null)
    {
        <div class="alert alert-success">
            <i class="fa fa-check"></i>
            Configuração atualizada com sucesso.
        </div>
    }

    @if (Model.Errors.HasErrors)
    {
        <div class="alert alert-danger">
            <i class="fa fa-ban"></i>
            <strong>Sua configuração apresenta erros</strong>:
            <ul>
                @foreach (var item in Model.Errors)
                {
                    <li><strong>@item.Key</strong>: @item.Value</li>
                }
            </ul>
        </div>
    }

    @if (Model.Warnings.HasErrors)
    {
        <div class="alert alert-warning">
            <i class="fa fa-exclamation-circle"></i>
            <strong>Alertas</strong>:
            <ul>
                @foreach (var item in Model.Warnings)
                {
                    <li><strong>@item.Key</strong>: @item.Value</li>
                }
            </ul>
        </div>
    }

    <div id="jsoneditor"></div>

    <br />

    @using (Html.BeginForm("Index", "Config", FormMethod.Post, new { id = "frmConfig" }))
    {
        @Html.HiddenFor(model => model.MaaSConfig)
        @Html.Localized("SAVE_CHANGES_BUTTON", "button", new { type = "submit", @class = "btn btn-primary btn-block", data_loading_text = "Aguarde..." })
    }
</section>

@section scripts
{
    <script src="~/Areas/Admin/plugins/jsoneditor/jsoneditor.js"></script>
    <script>ConfigIndex.init()</script>
}
