@model MoipConfigViewModel
@{

}

@Html.ValidationSummary(false, "", new { @class = "text-danger" })
@using (Ajax.BeginForm("ConfigureMoip", "Config", null, new AjaxOptions() { HttpMethod = "Post", UpdateTargetId = "moip-form" }, new { @class = "form-horizontal" }))
{
    <div class="form-group">
        <div class="col-xs-5 text-right">
            @Html.LabelFor(Model => Model.AccountKey, new { @class = "" })
        </div>
        <div class="col-xs-7">
            @Html.TextBoxFor(Model => Model.AccountKey, new { @class = "form-control gateway-info-input", placeholder = "Chave de Acesso" })
        </div>
        @Html.ValidationMessageFor(Model => Model.AccountKey, "", new { @class = "text-danger" })
    </div>
    <div class="form-group" style="margin-top:12px;">
        <div class="col-xs-5 text-right">
            @Html.LabelFor(Model => Model.AccountToken, new { @class = "" })
        </div>
        <div class="col-xs-7">
            @Html.TextBoxFor(Model => Model.AccountToken, new { @class = "form-control gateway-info-input", placeholder = "Token de Acesso" })
        </div>
        @Html.ValidationMessageFor(Model => Model.AccountToken, "", new { @class = "text-danger" })
    </div>
    <div class="form-group" style="margin-top:12px;">
        <div class="col-xs-5 text-right">
            @Html.LabelFor(Model => Model.PublicEncryptionKey, new { @class = "" })
        </div>
        <div class="col-xs-7">
            @Html.TextAreaFor(Model => Model.PublicEncryptionKey, new { style = "resize: vertical;", @class = "form-control gateway-info-input", placeholder = "-----BEGIN PUBLIC KEY-----..." })
        </div>
        @Html.ValidationMessageFor(Model => Model.PublicEncryptionKey, "", new { @class = "text-danger" })
    </div>
    <div class="text-center">
        <hr />
        @if (Model.IsConfigured())
        {
            <p><i class="fa fa-info-circle"></i>Gateway já configurado em produção, dados apenas para visualização</p>
        }
        else
        {
            <button class="btn btn-primary gateway-info-input" type="submit"><i class="fa fa-check"></i> Aplicar</button>
        }
    </div>
}
