@model ProductTemplateCreateEditViewModel
@{
    var config = MaaSConfig.Current;
    var decimalPlaceholder = (0m).DisplayDecimal(2);
}

<div class="row">
    <div class="col-xs-12 col-md-9">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title">Dados do produto</h3>
            </div>
            <div class="box-body">
                @Html.ValidationSummary()
                @Html.HiddenFor(model => model.Id)

                <div class="form-group">
                    @Html.LabelFor(model => model.Title)
                    @Html.TextBoxFor(model => model.Title, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Title)
                    <div class="checkbox">
                        <label>
                            @Html.CheckBoxFor(model => model.TitleIsEditable)
                            @Html.DisplayNameFor(model => model.TitleIsEditable)
                        </label>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            @Html.LabelFor(model => model.CategoryId)
                            @Html.DropDownListFor(model => model.CategoryId, Model.CategoryOptions, "Selecione...", new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.CategoryId)
                            <div class="checkbox">
                                <label>
                                    @Html.CheckBoxFor(model => model.CategoryIsEditable)
                                    @Html.DisplayNameFor(model => model.CategoryIsEditable)
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Description)
                    @Html.TextAreaFor(model => model.Description, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Description)
                    <div class="checkbox">
                        <label>
                            @Html.CheckBoxFor(model => model.DescriptionIsEditable)
                            @Html.DisplayNameFor(model => model.DescriptionIsEditable)
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Specification)
                    @Html.TextAreaFor(model => model.Specification, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Specification)
                    <div class="checkbox">
                        <label>
                            @Html.CheckBoxFor(model => model.SpecificationIsEditable)
                            @Html.DisplayNameFor(model => model.SpecificationIsEditable)
                        </label>
                    </div>
                </div>

                <hr />
                <h4>
                    <i class="fa fa-fw fa-image"></i>
                    @Html.Localized("PRODUCT_TEMPLATE_ADMIN_INPUT_IMAGES")
                </h4>
                <div class="form-group">
                    <input type="file" id="newImages" multiple>
                </div>
                <div id="uploadInfo" class="col-xs-12" style="display:none">
                    <p>
                        <i id="uploadSpinner" class="fa fa-spinner fa-spin" style="display:none"></i>
                        <span id="uploadPct"></span>
                        <i id="uploadOk" class="fa fa-check text-success" style="display:none"></i>
                    </p>
                </div>
                <div id="imagesContainer" class="row">
                    @Html.Partial("_Images", Model.Images)
                    @Html.ValidationMessageFor(model => model.Images)
                </div>
                <div class="checkbox">
                    <label>
                        @Html.CheckBoxFor(model => model.ImagesIsEditable)
                        @Html.DisplayNameFor(model => model.ImagesIsEditable)
                    </label>
                </div>

                @if (config.Product.Variants.Enabled)
                {
                    <hr />
                    <h4>
                        <i class="fa fa-fw fa-th-list"></i>
                        @Html.Localized("PRODUCT_TEMPLATE_ADMIN_INPUT_VARIANTS")
                    </h4>
                    @Html.ListBoxFor(model => model.Variants, Model.VariantOptions, new { @class = "form-control", multiple = "multiple" })
                    @Html.ValidationMessageFor(model => model.CategoryId)
                    <div class="checkbox">
                        <label>
                            @Html.CheckBoxFor(model => model.VariantsIsEditable)
                            @Html.DisplayNameFor(model => model.VariantsIsEditable)
                        </label>
                    </div>
                }

                @if (config.Product.AnyDimensionsEnabled)
                {
                    <hr />
                    <h4>
                        <i class="fa fa-fw fa-arrows-alt"></i>
                        @Html.Localized("PRODUCT_TEMPLATE_ADMIN_DIMENSIONS")
                    </h4>
                    <div class="checkbox">
                        <label>
                            @Html.CheckBoxFor(model => model.Dimensions.IsEditable)
                            @Html.DisplayNameFor(model => model.Dimensions.IsEditable)
                        </label>
                    </div>
                    <div class="row">
                        <div class="col-xs-6 col-sm-4 col-md-2">
                            <div class="form-group">
                                @Html.LabelFor(model => model.Dimensions.Length)
                                <div class="input-group">
                                    @Html.TextBoxFor(model => model.Dimensions.Length, new { @class = "form-control", placeholder = decimalPlaceholder })
                                    <span class="input-group-addon">cm</span>
                                </div>
                                @Html.ValidationMessageFor(model => model.Dimensions.Length)
                            </div>
                        </div>
                        <div class="col-xs-6 col-sm-4 col-md-2">
                            <div class="form-group">
                                @Html.LabelFor(model => model.Dimensions.Width)
                                <div class="input-group">
                                    @Html.TextBoxFor(model => model.Dimensions.Width, new { @class = "form-control", placeholder = decimalPlaceholder })
                                    <span class="input-group-addon">cm</span>
                                </div>
                                @Html.ValidationMessageFor(model => model.Dimensions.Width)
                            </div>
                        </div>
                        <div class="col-xs-6 col-sm-4 col-md-2">
                            <div class="form-group">
                                @Html.LabelFor(model => model.Dimensions.Height)
                                <div class="input-group">
                                    @Html.TextBoxFor(model => model.Dimensions.Height, new { @class = "form-control", placeholder = decimalPlaceholder })
                                    <span class="input-group-addon">cm</span>
                                </div>
                                @Html.ValidationMessageFor(model => model.Dimensions.Height)
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xs-6 col-sm-4 col-md-2">
                            <div class="form-group">
                                @Html.LabelFor(model => model.Dimensions.Weight)
                                <div class="input-group">
                                    @Html.TextBoxFor(model => model.Dimensions.Weight, new { @class = "form-control", placeholder = decimalPlaceholder })
                                    <span class="input-group-addon">kg</span>
                                </div>
                                @Html.ValidationMessageFor(model => model.Dimensions.Weight)
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-md-3">
        <div class="box box-warning">
            <div class="box-header with-border">
                @Html.Localized("PRODUCT_TEMPLATE_ADMIN_NOTES", "h3", new { @class = "box-title" })
            </div>
            <div class="box-body">
                @Html.Localized("PRODUCT_TEMPLATE_ABOUT_TEXT", "p")
                @if (Url.IsCurrent("Edit", "ProductTemplates"))
                {
                    @:@Html.Localized("PRODUCT_TEMPLATE_EFFECTS_OF_UPDATING", "p")
                }
            </div>
        </div>
    </div>
</div>

<div class="box">
    <div class="box-header with-border">
        @Html.Localized("PRODUCT_TEMPLATE_ADMIN_VISIBILITY_CONTROL", "h3", new { @class = "box-title" })
    </div>

    <div class="box-body">
        <div class="form-group">
            <div class="checkbox">
                <label>
                    @Html.CheckBoxFor(model => model.IsEnabled)
                    @Html.DisplayNameFor(model => model.IsEnabled)
                </label>
            </div>
            <div class="help-block">
                <span class="text-muted">Esta opção define se o modelo estará disponível para que vendedores configurem produtos a partir dele</span>
            </div>
        </div>
    </div>
</div>
