@model IEnumerable<Domain.DTO.ApiTokenListing>

@{
    ViewBag.Title = "Tokens de api";
}

<section class="content-header">
    <h1>
        <i class="fa fa-indent"></i>
        @ViewBag.Title
    </h1>
</section>

<section class="content container-fluid">
    <p>
        @Html.ActionLink("Gerar novo token", "Create", null, new { @class = "btn btn-primary" })
    </p>
    
    <div class="box">
    <div class="box-body table-responsive">
    <table class="table table-hover js-items-list">
        <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Token)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SellerName)
            </th>
            <th>
                Ações
            </th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Token)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SellerName)
                </td>
                <td>
                    @Html.ActionLink("Editar", "Edit", new { id = item.Id }) |
                    @Html.ActionLink("Revogar", "Revoke", new { id = item.Id }, new { @class = "js-delete-item", data_item = item.Name })
                </td>
            </tr>
        }
        </tbody>
    </table>
        </div>
    </div>
</section>

@section scripts
{
    <script>DataTableCustom.create()</script>

    <script>
        $(document).ready(function() {
            $('.js-items-list .js-delete-item').click(function(e) {
                e.preventDefault();

                var $this = $(this);

                swal({
                        title: "Atenção",
                        text: "Confirma a revogação do item '" + $this.data('item').trim() + "'?",
                        type: "warning",
                        showCancelButton: true,
                        confirmButtonText: "Sim, confirmo",
                        cancelButtonText: "Cancelar",
                        closeOnConfirm: false
                    },
                    function() {
                        $.redirect($this.attr('href'));
                    });
            });
        });
    </script>
}
