@section scripts
{
    <script>Customize.init()</script>

    <script>
        (function ($, MaaS) {

            var $newImagesInput = $('.new-images');
            var $submitButton = $('.js-submit');

            $newImagesInput.each(function (index) {
                let hiddenField = $(this).parent().children('.new-images-hidden');
                let imgPreview = $(this).parent().parent().find('.new-images-preview');

                $(this).uploadfy({
                    fileType: 'platform',
                    started: function () {
                        submitToggle(false);
                    },
                    progress: function (percentage) {
                        console.log(percentage);
                    },
                    completed: function (files) {
                        hiddenField.val(files[0]);
                        if (imgPreview) {
                            imgPreview.attr('src', files[0]);
                        }
                    },
                    error: function () {
                        toastr.error(MaaS.messages.upload_error);
                    },
                    finaly: function () {
                        submitToggle(true);
                    }
                });
            });

            function submitToggle(enable) {
                if (enable === false) {
                    $submitButton.button('loading');
                } else {
                    $submitButton.button('reset');
                }
            }

        })(window.jQuery, window.MaaS);
    </script>
}