@model Presentation.Areas.Admin.Models.CustomizeUserConfigVM

<p>Configure até 3 links personalizados que serão exibidos no menu superior das páginas da plataforma</p>
<hr />
@using (Html.BeginForm("CustomLinks", "NewCustomize", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    for (int i = 0; i < 3; i++)
    {
        <div class="form-group">
            <label class="control-label col-sm-offset-2 col-sm-10" style="text-align:left !important">@Html.CheckBoxFor(model => model.CustomLinks[i].Enabled, new { @class = "" }) Habilitar</label>
        </div>
        <div class="form-group">
            @Html.Label("Título", new { @class = "control-label col-sm-2" })
            <div class="col-sm-10">
                @Html.TextBoxFor(model => model.CustomLinks[i].Label, new { @class = "form-control", placeholder = "Nome do item no menu" })
                @Html.ValidationMessageFor(model => model.CustomLinks[i].Label, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.Label("Link", new { @class = "control-label col-sm-2" })
            <div class="col-sm-10">
                @Html.TextBoxFor(model => model.CustomLinks[i].Url, new { @class = "form-control", placeholder = @"https://www.exemplo.com/pagina" })
                @Html.ValidationMessageFor(model => model.CustomLinks[i].Url, "", new { @class = "text-danger" })
            </div>
        </div>
        <hr />
    }
    <div class="text-center">
        <button class="btn btn-primary" type="submit"><i class="fa fa-check"></i> Aplicar</button>
    </div>
}