@model Presentation.Areas.Admin.Models.CustomizeUserConfigVM
@{
    ViewBag.Title = "Outras opções";
}

<section class="content-header">
    @Html.Partial("_CustomizeMenu", 5)
</section>

<section class="content container-fluid">
    <br />
    <div class="row">
        <div class="col-xs-12 col-md-6">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h1 class="panel-title">Configurações</h1>
                </div>
                <div class="panel-body">
                    @Html.Partial("_UserConfig", Model.UserConfig)
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-md-6">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h1 class="panel-title">Links Personalizados</h1>
                </div>
                <div class="panel-body">
                    @Html.Partial("_CustomLinks", Model)
                </div>
            </div>
        </div>
    </div>
</section>