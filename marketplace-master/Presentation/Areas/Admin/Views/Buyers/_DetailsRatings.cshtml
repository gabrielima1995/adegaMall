@using Presentation.Helpers
@model List<Domain.Modules.Ratings.UserRatingModel>

@{
    var config = MaaSConfig.Current;
}

@if (config.Buyer.UserRatings.Enabled)
{
    <div class="box">
        <div class="box-header">
            <h3 class="box-title">Avaliações</h3>
        </div>
        <div class="box-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Avaliador</th>
                                <th>Nota</th>
                                <th>Comentário</th>
                                <th>Data</th>
                                <th>Status</th>
                                <th>Moderar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><a href="@Url.ActionLocalized("Details", "Ratings", new { id = item.Id.ToString() })">@item.Id.ToString().Truncate(8)</a></td>
                                    <td><a href="~/admin/buyers/details/@item.RatingSenderId">@item.SenderName</a></td>
                                    <td data-order="@Dt.Order(item.Rating.GetValueOrDefault()) " class="text-center" style="width:100px;">
                                        @Html.Partial("_RatingStars", (double)item.Rating.Value)
                                    </td>
                                    <td>@(item.Comment == null ? "-" : item.Comment.Truncate(30))</td>
                                    <td>@item.CreatedAt.ToShortDateString()  @item.CreatedAt.ToShortTimeString()</td>
                                    <td class="text-center">@(item.Hidden ? "Oculto" : "Visível")</td>
                                    <td class="text-center">
                                        @if (item.Hidden)
                                        {
                                            <a class="btn btn-sm btn-success" href="@Url.ActionLocalized("ModerateRating","Ratings", new { id = item.Id.ToString(), hidden = false})">
                                                <i class="fa fa-undo"></i>
                                                Exibir
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="btn btn-sm btn-danger" href="@Url.ActionLocalized("ModerateRating","Ratings", new { id = item.Id.ToString(), hidden = true})">
                                                <i class="fa fa-ban"></i>
                                                Ocultar
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p>Nenhuma avaliação recebida.</p>
            }
        </div>
    </div>
}