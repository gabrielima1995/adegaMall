@model OrderDetailsViewModel

@{
    ViewBag.Title = Model.Title;
}

<section class="content-header">
    <h1>
        <i class="fa fa-cubes" aria-hidden="true"></i>
        @ViewBag.Title
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.ActionLocalized("Index", "Dashboard")"><i class="fa fa-home"></i> Home</a></li>
        <li><a href="@Url.ActionLocalized("Index", "Orders")">Pedidos</a></li>
        <li class="active">Detalhes do Pedido</li>
    </ol>
</section>

<section class="content container-fluid">
    <div class="box">
        <div class="box-body no-padding">
            <div class="row">
                <div class="col-md-5">
                    @Html.Partial("_DetailsInfo", Model)
                </div>
                <div class="col-md-7">
                    <div class="row">
                        <div class="col-md-6">
                            @Html.Partial("~/Areas/Admin/Views/Shared/_DetailsBuyer.cshtml", Model.Buyer)
                        </div>
                        <div class="col-md-6">
                            @Html.Partial("~/Areas/Admin/Views/Shared/_DetailsSeller.cshtml", Model.Seller)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (MaaSConfig.Current.Product.Order.ExtraInfoField.Enabled && Model.ExtraInfo != null)
    {
        <div class="panel panel-default">
            <div class="panel-body">
                @Html.Localized("ORDER_EXTRA_INFO_TITLE", "label")
                @Html.Markdown(Model.ExtraInfo)
            </div>
        </div>
    }

    @Html.Partial("_DetailsProducts")
    @Html.Partial("_DetailsHistory")
</section>
