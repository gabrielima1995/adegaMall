@model CustomItemViewModel

<div class="box">
    <div class="box-header">
        <h3 class="box-title">@(Model.IsEditing ? "Editar Item" : "Novo Item")</h3>
    </div>
    <div class="box-body">
        @using (Html.BeginForm("CustomItemOperation", "CustomItem", FormMethod.Post))
        {
            @Html.HiddenFor(model => model.Id);
            @Html.HiddenFor(model => model.IsEditing);
            @Html.HiddenFor(model => model.CategoryId);

            <div class="row">
                <div class="col-xs-12 form-group-sm">
                    <label for="Title">Título</label>
                    <input type="text" name="Title" class="form-control" placeholder="Título" value="@Model.Title">
                    @Html.ValidationMessageFor(model => model.Title)
                </div>
            </div>

            <div class="form-group-sm">
                <label>Link</label>
                <input type="text" name="TargetUrl" class="form-control" placeholder="Link" value="@Model.TargetUrl">
            </div>

            <div class="row">
                <div class="col-xs-6 form-group-sm">
                    <label>Data Início (opcional)</label>
                    @Html.ValidationMessageFor(model => model.StartDate)
                    @Html.TextBox("StartDate", Model.StartDate.HasValue ? Model.StartDate.Value.ToShortDateString() : "", new { @class = "form-control datepicker datemask" })
                </div>
                <div class="col-xs-6 form-group-sm">
                    <label>Data Final (opcional)</label>
                    @Html.TextBox("EndDate", Model.EndDate.HasValue ? Model.EndDate.Value.ToShortDateString() : "", new { @class = "form-control datepicker datemask" })
                    @Html.ValidationMessageFor(model => model.EndDate)
                </div>
            </div>


            <div class="form-group-sm">
                <label>Imagem</label>
                @Html.HiddenFor(model => model.ImageUrl, new { id = "image-hidden-url" })
                @Html.TextBoxFor(model => model.UploadedImage, new { id = "image-upload-form", type = "file" })
                @Html.ValidationMessageFor(model => model.ImageUrl, "", new { @class = "text-danger" })
                <i id="uploadSpinner" class="fa fa-spin fa-spinner" style="display:none"></i>
                <small id="uploadPercent" style="display:none">enviando, aguarde...</small>
            </div>

            <br />
            <button type="submit" id="custom-item-submit" class="btn btn-success" data-loading-text="Aguarde...">Enviar</button>
        }
    </div>
</div>