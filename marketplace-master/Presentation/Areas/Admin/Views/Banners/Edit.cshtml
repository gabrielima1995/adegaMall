@model BannerCreateEditVM

@{
    ViewBag.Title = Request.GetLocalizedString("BANNERS_EDIT_TITLE");
}

<section class="content-header">
    <h1>
        <i class="fa fa-picture-o" aria-hidden="true"></i>
        @ViewBag.Title
    </h1>
</section>

<section class="content container-fluid">
    <div class="row">
        <div class="col-xs-12 col-md-6">
            <div class="box box-primary">
                @using (Html.BeginForm("Edit", "Banners", FormMethod.Post, new { role = "form", enctype = "multipart/form-data" }))
                {
                    <div class="box-body">
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary()
                        @Html.EditorForModel("_BannerEditorPartial")
                    </div>
                    <div class="box-footer">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-check"></i>
                            @Request.GetLocalizedString("SAVE_CHANGES_BUTTON")
                        </button>
                        <a href="@Url.ActionLocalized("Index", "Banners")" class="btn btn-link">
                            @Request.GetLocalizedString("CANCEL_LABEL")
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
