@using Domain.Modules.Integration

@model IntegrationParameterFromGoogleVM


<h4><i class="fa fa-newspaper-o" aria-hidden="true"></i>  Novo</h4>




@using (Html.BeginForm("Create", "IntegrationParameterFromGoogle", new { lang = Request.GetCurrentLang() }, FormMethod.Post, new { @class = "margin-top-15", role = "form" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(i => i.Id, new { @class = "form-control idguid_editar" })

    <div class="form-group">
        @Html.TextBoxFor(i => i.AccountId, new { @class = "form-control", placeholder = "Account Id" })
        @Html.ValidationMessageFor(model => model.AccountId, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.TextBoxFor(i => i.ClientId, new { @class = "form-control", placeholder = "ClientId" })
        @Html.ValidationMessageFor(model => model.ClientId, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.TextBoxFor(i => i.ClientEmail, new { @class = "form-control", placeholder = Request.GetLocalizedString("EMAIL_INPUT"), type = "email" })
        @Html.ValidationMessageFor(model => model.ClientEmail, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.TextAreaFor(m => m.PrivateKey, new { @class = "form-control", placeholder = "Private Key", @rows = 5 })
        @Html.ValidationMessageFor(model => model.PrivateKey, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.Localized("SAVE_CHANGES_BUTTON", "button", new { type = "submit", @class = "btn btn-primary btn-block" })
    </div>
}