@model Presentation.Areas.Admin.Views.Products.ImportResultsModel

@{
    ViewBag.Title = Request.GetLocalizedString("IMPORT_PRODUCTS_RESULT");
}

<section class="content-header">
    <h1>
        <i class="fas fa-file-import" aria-hidden="true"></i>
        @ViewBag.Title
    </h1>

    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Dashboard")"><i class="fa fa-dashboard"></i> @Request.GetLocalizedString("ADMIN_DASHBOARD")</a></li>
        <li class="active">@Request.GetLocalizedString("IMPORT_PRODUCTS")</li>
    </ol>
</section>

<section class="content container-fluid">
    @if (!Model.HasModelErrors && Model.Results.IsValid)
    {
        <div class="box box-success">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-check text-success"></i> @Html.Localized("PRODUCTS_IMPORT_SUCCESS_TITLE")</h3>
            </div>
            <div class="box-body">
                @Html.Localized("PRODUCTS_IMPORT_SUCCESS_TEXT", "p")
            </div>
        </div>

        <a href="@Url.Action("Import", "Products", new { area = "Admin" })">
            <i class="fa fa-fw fa-chevron-left"></i>
            voltar para importar imagens ou mais produtos
        </a>
    }
    else
    {
        <div class="box">
            <div class="box-header with-border">
                <h3 class="box-title">@Html.Localized("PRODUCTS_IMPORT_TRY_AGAIN")</h3>
            </div>
            <div class="box-body">
                @Html.Localized("PRODUCTS_IMPORT_RESULT_ERROR_TEXT", "p")
                @Html.Partial("_UploadImportFile")
            </div>
        </div>

        <div class="box box-danger">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-times text-danger"></i> @Html.Localized("PRODUCTS_IMPORT_RESULT_ERROR_TITLE")</h3>
            </div>
            <div class="box-body">
                @Html.ValidationSummary()

                @if (Model.Results.HasErrors)
                {
                    @Html.Localized("PRODUCTS_IMPORT_HOVER_OVER_ERROR", "p")
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    @foreach (var name in Model.Results.FieldNames)
                                    {
                                        <td>@name</td>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Results.InvalidRecords)
                                {
                                    <tr>
                                        @foreach (var f in item.Fields)
                                        {
                                            if (f.HasErrors)
                                            {
                                                <td class="danger" title="@string.Join(", ", f.Errors)">@f.Value</td>
                                            }
                                            else
                                            {
                                                <td>@f.Value</td>
                                            }
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</section>

@section Scripts
{
    <script>ProductsImport.init()</script>
}
