@model List<V2.Infrastructure.Modules.Metrics.MetricsQueriesCartVM>

@{
    ViewBag.Title = "Carrinhos Abandonados";
    var config = MaaSConfig.Current;
}

<section class="content-header">
    <div class="row">
        <div class="col-xs-12 col-sm-12">
            <h1>
                <i class="fa fa-dashboard" aria-hidden="true"></i>
                @ViewBag.Title
            </h1>
        </div>
        <div class="col-xs-12 col-sm-4">
            @using (Html.BeginForm("Carts", "Dashboard", FormMethod.Get))
            {
                <div class="row">
                    <div class="col-xs-5 form-group">
                        <label>Data Inicial</label>
                        @Html.TextBox("startDate", "", new { @class = "form-control datepicker datemask" })
                    </div>

                    <div class="col-xs-5 form-group">
                        <label>Data Final</label>
                        @Html.TextBox("endDate", "", new { @class = "form-control datepicker datemask" })
                    </div>

                    <div class="col-xs-1">
                        <button class="btn btn-success" type="submit" style="margin-top: 23px">
                            <i class="fa fa-refresh"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="content container-fluid">
    <div class="box">
        <div class="box-body table-responsive">
            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <td>Carrinho</td>
                        <th>Nome</th>
                        <th>Email</th>
                        <th>Valor</th>
                        <th>Data</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.ActionLink(item.CartId.Substring(0, 8), "CartDetails", new { buyerId = item.BuyerId })</td>
                            <td><a href="@(config.Environment.AppUrl + $"admin/buyers/details/{item.BuyerId}")">@item.BuyerName</a></td>
                            <td>@item.Email</td>
                            <td>@config.DefaultCurrency@item.CartValue.RoundTo2Places()</td>
                            <td>@item.CartDate.DisplayDateTime()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@section scripts
{
    <script>
        DataTableCustom.create('table', {
            'order': [[4, 'desc']]
        });
    </script>
}