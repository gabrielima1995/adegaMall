@model Domain.Entities.StoreModule.Cart

@{
    ViewBag.Title = "Detalhes de Carrinho Abandonado";

    var config = MaaSConfig.Current;
}

<section class="content-header">
    <h1>
        <i class="fa fa-user" aria-hidden="true"></i>
        @ViewBag.Title
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.ActionLocalized("Index", "Dashboard")"><i class="fa fa-home"></i> Dashboard</a></li>
        <li class="active">Detalhes do Carrinho</li>
    </ol>
</section>

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-3">
            @Html.Partial("_DetailsBuyer", Model.Buyer)
        </div>
        <div class="col-md-9">
            <div class="box">
                <div class="box-body table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <td>Produto</td>
                                <th>Nome</th>
                                <th>Categoria</th>
                                <th>Preço</th>
                                <th>Quantidade</th>
                                @if (config.Product.BusinessModel.Rental.Enabled)
                                {
                                    <th>Duração</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@(item.Product.Id.ToString().Substring(0, 8))</td>
                                    <td>@item.Product.Title</td>
                                    <td>@item.Product.Category.Name</td>
                                    <td>@config.DefaultCurrency@item.Product.Price.Value.RoundTo2Places()</td>
                                    <td>@item.Quantity</td>
                                    @if (config.Product.BusinessModel.Rental.Enabled)
                                    {
                                        <td>@(item.RentalInfo.RentalPeriodValue ?? 0)</td>
                                    }
                                </tr>
                            }
                            <tr>
                                <td><strong>Total</strong></td>
                                <td>--</td>
                                <td>--</td>
                                <td><strong>@config.DefaultCurrency@((Model.Amount - Model.Shipping).RoundTo2Places())</strong></td>
                                <td><strong>@Model.Items.Sum(x => x.Quantity)</strong></td>
                                @if (config.Product.BusinessModel.Rental.Enabled)
                                {
                                    <td>--</td>
                                }
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
